--- editors/emacs29-nox11/version.mk.orig
+++ editors/emacs29-nox11/version.mk
@@ -1,7 +1,9 @@
 # $NetBSD: version.mk,v 1.1 2023/07/31 15:05:54 ryoon Exp $
 
-_EMACS_FLAVOR=	emacs
-_EMACS_REQD=	emacs29-nox11>=29.1<30
+# The only thing that differs from the X11 build is which package to
+# ask for.  Everything else -- the flavour, the version -- is one fact
+# about one Emacs, and it was being written twice: this file said
+# 29.1 while ../emacs29 said 29.4 and the package built 29.4.
+.include "../../editors/emacs29/version.mk"
 
-_EMACS_VERSION_MAJOR=	29
-_EMACS_VERSION_MINOR=	1
+_EMACS_REQD=	emacs29-nox11>=29.1<30
