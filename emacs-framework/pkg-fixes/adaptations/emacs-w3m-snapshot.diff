--- www/emacs-w3m-snapshot/Makefile.orig
+++ www/emacs-w3m-snapshot/Makefile
@@ -25,7 +25,10 @@
 CONFIGURE_ARGS+=	--localstatedir=${VARBASE}
 CONFIGURE_ENV+=		GAMEOWN=${GAMES_USER}
 BUILD_TARGET=
-WRKSRC=			${WRKDIR}/${PKGBASE}-${PKGBASE}-${HASH}
+# 展開される dir の名前は配布物で決まっていて、package 名とは関係が無い。
+# ${PKGBASE} で綴ると EMACS_PKGNAME_PREFIX が付いたときに二重に入り、
+# cd が落ちる。VERSION や HASH と同じく、ここも直に書く。
+WRKSRC=			${WRKDIR}/emacs-w3m-emacs-w3m-${HASH}
 
 SUBST_CLASSES+=		paths
 SUBST_MESSAGE.paths=	Fixing paths.
