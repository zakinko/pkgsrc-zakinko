--- inputmethod/tamago-tsunagi/Makefile.orig
+++ inputmethod/tamago-tsunagi/Makefile
@@ -14,7 +14,12 @@
 CONFLICTS=	tamago-anthy-[0-9]*
 CONFLICTS+=	tamago-[0-9]*
 
+# egg-com.el uses read syntax Emacs 20 does not have ("Invalid read
+# syntax: #" at byte-compile), so it cannot be built for emacs20.
+EMACS_VERSIONS_INCOMPATIBLE=	emacs20
+
 GNU_CONFIGURE=		yes
+INSTALL_MAKE_FLAGS+=	lispdir=${EMACS_LISPPREFIX}
 
 .include "../../editors/emacs/modules.mk"
 .include "../../mk/bsd.pkg.mk"
