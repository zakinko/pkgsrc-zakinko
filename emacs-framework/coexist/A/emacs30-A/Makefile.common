# $NetBSD: Makefile.common,v 1.4 2026/02/24 07:13:49 triaxx Exp $
#
# used by editors/emacs30/Makefile
# used by editors/emacs30-nox11/Makefile

.include "../../mk/bsd.prefs.mk"

DISTNAME=	emacs-${EMACS_VERSION}
PKGNAME?=	${DISTNAME:S/emacs/emacs30/}
CATEGORIES=	editors
MASTER_SITES=	${MASTER_SITE_GNU:=emacs/}
EXTRACT_SUFX=	.tar.xz

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://www.gnu.org/software/emacs/
COMMENT=	GNU editing macros (editor)
LICENSE=	gnu-gpl-v3

.include "../../netbsd-i386-3e/emacs30-A/version.mk"
EMACS_VERSION=	${_EMACS_VERSION_MAJOR}.${_EMACS_VERSION_MINOR}

WRKSRC=		${WRKDIR}/${DISTNAME:S/b$//}

AUTOCONF_REQD+=	2.65
TEXINFO_REQD+=	4.13

GNU_CONFIGURE=	yes
INFO_FILES=	yes
USE_TOOLS+=	gmake gzip makeinfo gm4 gsed

CONFIGURE_ARGS+=	--srcdir=${WRKSRC}
CONFIGURE_ARGS+=	--localstatedir=${VARBASE}
CONFIGURE_ARGS+=	--disable-autodepend
CONFIGURE_ENV+=		GAMEOWN=${GAMES_USER}

USE_GAMESGROUP=		yes

BUILD_DEFS+=		VARBASE
BUILD_DEFS+=		GAMEDATAMODE
# The nox build installs under its own EMACS_TAG, so its file list is
# not the X one; it brings its own PLIST.  EMACS_TAG is only set this
# early by a package that overrides it.
.if defined(EMACS_TAG)
PLIST_SRC+=		${.CURDIR}/PLIST
.else
PLIST_SRC+=		../../netbsd-i386-3e/emacs30-A/PLIST
.endif

MAKE_DIRS_PERMS+=	${VARBASE}/games/emacs ${GAMES_USER} ${GAMES_GROUP} ${GAMEDIRMODE}
CONF_FILES_PERMS+=	/dev/null ${VARBASE}/games/emacs/snake-scores \
			${GAMES_USER} ${GAMES_GROUP} ${GAMEDATAMODE}
CONF_FILES_PERMS+=	/dev/null ${VARBASE}/games/emacs/tetris-scores \
			${GAMES_USER} ${GAMES_GROUP} ${GAMEDATAMODE}

SPECIAL_PERMS+=		${_EMACS_ARCHLIB}/update-game-score ${SETGID_GAMES_PERMS}

# build PATH in the dumped emacs is not a problem
CHECK_WRKREF_SKIP+=	bin/emacs
CHECK_WRKREF_SKIP+=	bin/emacs-${EMACS_TAG}
CHECK_WRKREF_SKIP+=	${_EMACS_ARCHLIB}/emacs.pdmp

CHECK_PORTABILITY_SKIP+=	admin/download-android-deps.sh

PRINT_PLIST_AWK+=	{ gsub(/${MACHINE_GNU_PLATFORM}/, "$${MACHINE_GNU_PLATFORM}"); }

.if (${OPSYS} == "NetBSD") && \
    !exists(/usr/lib/libgcc_s.so) && !exists(/usr/lib/libgcc.a)
# NetBSD with native Clang doesn't provide libgcc, everything is in libc.
pre-configure: fake-libgcc

.PHONY: fake-libgcc
fake-libgcc:
	${AR} q ${BUILDLINK_DIR}/lib/libgcc.a
.endif

.if (${OPSYS} == "NetBSD") && exists(/usr/include/term.h)
CPPFLAGS+=	-DTERMINFO
.elif ${OPSYS} == "FreeBSD" || ${OPSYS} == "Linux" || ${OPSYS} == "OpenBSD"
.include "../../mk/curses.buildlink3.mk"
.else
.include "../../mk/termcap.buildlink3.mk"
.endif

.include "../../mk/oss.buildlink3.mk"

post-extract:
	# set auto-load for send-pr library
	cp ${.CURDIR}/../../netbsd-i386-3e/emacs30-A/files/site-init.el ${WRKSRC}/lisp

# by default the filename of the emacs dump contains a fingerprint of the corresponding emacs version
# but this is not needed and makes the PLIST more simple
post-install:
	cd ${DESTDIR}${PREFIX}/${_EMACS_ARCHLIB} && \
		mv emacs-*.pdmp emacs.pdmp
	${RM} -f ${DESTDIR}${PREFIX}/share/emacs/site-lisp/subdirs.el

.if ${OPSYS} != "Darwin"
.  include "../../devel/libgetopt/buildlink3.mk"
.endif

# Let several Emacsen live in one prefix.  Everything upstream would
# install under a name that carries no version gets one, and the bare
# names come back through ALTERNATIVES.  configure does the renaming:
# program_transform_name is honoured for the binaries, their man pages
# and the icons, so no Makefile has to be patched.
#
# EMACS_TAG, not EMACS_VERSION, is what goes into the names.  For the X
# build it is the version; the nox build of the same version adds a
# suffix, because the two are one version built two ways and would
# otherwise land on the same 4341 paths.  Everything Emacs installs
# hangs off ${datadir}, ${libexecdir} and the program names, and all
# three take a value, so no source change is needed:
#
#	share/emacs/30.2/...        share/emacs/30.2-nox11/...
#	libexec/emacs/30.2/...      libexec/emacs/30.2-nox11/...
#	bin/emacs-30.2              bin/emacs-30.2-nox11
#
# The cost is that an elisp package no longer serves both: the lisp
# directory differs, so emacs30-foo and emacs30-nox11-foo are two
# builds.  Leave EMACS_TAG at the version and the two variants conflict
# as before, which is what upstream does.
EMACS_TAG?=		${EMACS_VERSION}
CONFIGURE_ARGS+=	--program-transform-name='s/$$/-${EMACS_TAG}/'
CONFIGURE_ARGS+=	--includedir=${PREFIX}/include/emacs-${EMACS_TAG}

# Only a variant moves its tree.  When EMACS_TAG is the plain version the
# layout is what it has always been, so the X build that is already
# measured does not change.
.if ${EMACS_TAG} != ${EMACS_VERSION}
_EMACS_DATADIR=		share/emacs-${EMACS_TAG}
_EMACS_LIBEXEC=		libexec/emacs-${EMACS_TAG}
CONFIGURE_ARGS+=	--datadir=${PREFIX}/${_EMACS_DATADIR}
CONFIGURE_ARGS+=	--libexecdir=${PREFIX}/${_EMACS_LIBEXEC}
.else
_EMACS_DATADIR=		share
_EMACS_LIBEXEC=		libexec
.endif
_EMACS_ARCHLIB=		${_EMACS_LIBEXEC}/emacs/${PKGVERSION_NOREV}/${MACHINE_GNU_PLATFORM}
GNU_CONFIGURE_INFODIR=	${PREFIX}/${_EMACS_DATADIR}/emacs/${EMACS_VERSION}/info
INFO_FILES=		# the info files are private to this Emacs now
PLIST_SUBST+=		EMACS_VERSION=${EMACS_VERSION}
PLIST_SUBST+=		EMACS_TAG=${EMACS_TAG}
FILES_SUBST+=		EMACS_TAG=${EMACS_TAG}
PRINT_PLIST_AWK+=	{ gsub(/${EMACS_TAG}/, "$${EMACS_TAG}"); }
PRINT_PLIST_AWK+=	{ gsub(/${EMACS_VERSION}/, "$${EMACS_VERSION}"); }
