$NetBSD$

Install the binaries and the man pages under the name
program_transform_name asks for, so that more than one Emacs can share
a prefix.  21.4 accepts --program-transform-name and never uses it.

No ${DESTDIR} here: the package passes prefix=${DESTDIR}${PREFIX} and
mandir=${DESTDIR}... in INSTALL_MAKE_FLAGS, so bindir and man1dir
already carry it and adding it again writes .destdir twice.

--- lib-src/Makefile.in.orig
+++ lib-src/Makefile.in
@@ -22,6 +22,9 @@
 # inherited from the environment.
 SHELL = /bin/sh
 
+# Program name transformation.
+TRANSFORM = @program_transform_name@
+
 # ==================== Things `configure' will edit ====================
 
 CC=@CC@
@@ -85,6 +88,7 @@
 INSTALL = @INSTALL@
 INSTALL_PROGRAM = @INSTALL_PROGRAM@
 INSTALL_DATA = @INSTALL_DATA@
+INSTALL_SCRIPT = @INSTALL_SCRIPT@
 # By default, we uphold the dignity of our programs.
 INSTALL_STRIP =
 
@@ -288,7 +292,7 @@
         if [ `(cd ${archlibdir} && /bin/pwd)` \
              != `(cd ${srcdir} && /bin/pwd)` ]; then \
 	  for file in ${SCRIPTS}; do \
-	    $(INSTALL_PROGRAM) ${srcdir}/$$file ${archlibdir}/$$file; \
+	    $(INSTALL_SCRIPT) ${srcdir}/$$file ${archlibdir}/$$file; \
 	  done ; \
 	fi
 
@@ -296,12 +300,12 @@
 	@echo
 	@echo "Installing utilities for users to run."
 	for file in ${INSTALLABLES} ; do \
-	  $(INSTALL_PROGRAM) $(INSTALL_STRIP) $${file} ${bindir}/$${file} ; \
-	  chmod a+rx ${bindir}/$${file}; \
+	  $(INSTALL_PROGRAM) $(INSTALL_STRIP) $${file} ${bindir}/`echo $${file} | sed '$(TRANSFORM)'` ; \
+	  chmod a+rx ${bindir}/`echo $${file} | sed '$(TRANSFORM)'`; \
 	done
 	for file in ${INSTALLABLE_SCRIPTS} ; do \
-	  $(INSTALL_PROGRAM) ${srcdir}/$${file} ${bindir}/$${file} ; \
-	  chmod a+rx ${bindir}/$${file}; \
+	  $(INSTALL_SCRIPT) ${srcdir}/$${file} ${bindir}/`echo $${file} | sed '$(TRANSFORM)'` ; \
+	  chmod a+rx ${bindir}/`echo $${file} | sed '$(TRANSFORM)'`; \
 	done
 
 uninstall:
