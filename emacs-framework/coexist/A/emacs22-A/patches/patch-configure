$NetBSD$

Five changes to the generated configure.  configure.in gets the matching one
where there is one; see patch-configure.in.

gameuser was hard-coded to "games".  Take it from GAMEOWN instead, which the
package passes in CONFIGURE_ENV, so that the score files end up owned by
whatever GAMES_USER is on this system.

mips NetBSD selected m/pmax.h, the DECstation description.  Point it at
m/mips.h; patch-src_m_mips.h puts a usable file there.  This is the half that
matters for building -- configure.in has the same change so that the two do
not drift.

Recognise *-dragonfly* as opsys=dragonfly.  The package supplies
files/dragonfly.h as src/s/dragonfly.h.

Look for EGifPutExtensionTrailer in -lgif rather than EGifPutExtensionLast in
-lungif.  libungif is gone and giflib 5 renamed the function; without this,
configure decides there is no GIF support.

Ask for cpp -traditional unconditionally.  The test above it only checks that
the preprocessor leaves ".." alone, and a cpp that passes that can still ruin
the generated Makefile: without -traditional it splices a backslash-newline
and then splits the line again to keep the line numbering, and the backslash
does not come back.  Every continued variable and recipe in Makefile.in then
arrives as two lines, and GNU make 4 stops with "recipe commences before first
target".  The reasoning is repeated in the hunk itself, where someone reading
the generated configure will find it.

--- configure.orig	2008-09-05 16:21:51.000000000 +0000
+++ configure
@@ -1809,7 +1809,7 @@ archlibdir='${libexecdir}/emacs/${versio
 docdir='${datadir}/emacs/${version}/etc'
 gamedir='${localstatedir}/games/emacs'
 
-gameuser=games
+gameuser=${GAMEOWN}
 
 
 # Check whether --with-gcc was given.
@@ -2243,9 +2243,9 @@ _ACEOF
       m68k-*-netbsd*)
 			# This is somewhat bogus.
 			machine=hp9000s300 ;;
-      mips-*-netbsd*)	machine=pmax ;;
-      mipsel-*-netbsd*)	machine=pmax ;;
-      mipseb-*-netbsd*)	machine=pmax ;;
+      mips-*-netbsd*)	machine=mips ;;
+      mipsel-*-netbsd*)	machine=mips ;;
+      mipseb-*-netbsd*)	machine=mips ;;
       ns32k-*-netbsd*)	machine=ns32000 ;;
       powerpc-*-netbsd*) machine=macppc ;;
       sparc*-*-netbsd*)	machine=sparc ;;
@@ -3142,6 +3142,7 @@ _ACEOF
       *-sysv5uw* )	  	opsys=unixware; NON_GNU_CPP=/lib/cpp ;;
       *-sysv5OpenUNIX* )  	opsys=unixware; NON_GNU_CPP=/lib/cpp ;;
       *-386bsd* )	        opsys=386bsd ;;
+      *-dragonfly* )            opsys=dragonfly ;;
       *-nextstep* )             opsys=nextstep ;;
       ## Otherwise, we'll fall through to the generic opsys code at the bottom.
     esac
@@ -13897,13 +13898,13 @@ fi
 if test $ac_cv_header_gif_lib_h = yes; then
   # EGifPutExtensionLast only exists from version libungif-4.1.0b1.
 # Earlier versions can crash Emacs.
-      { echo "$as_me:$LINENO: checking for EGifPutExtensionLast in -lungif" >&5
-echo $ECHO_N "checking for EGifPutExtensionLast in -lungif... $ECHO_C" >&6; }
+      { echo "$as_me:$LINENO: checking for EGifPutExtensionTrailer in -lgif" >&5
+echo $ECHO_N "checking for EGifPutExtensionTrailer in -lgif... $ECHO_C" >&6; }
 if test "${ac_cv_lib_ungif_EGifPutExtensionLast+set}" = set; then
   echo $ECHO_N "(cached) $ECHO_C" >&6
 else
   ac_check_lib_save_LIBS=$LIBS
-LIBS="-lungif  $LIBS"
+LIBS="-lgif  $LIBS"
 cat >conftest.$ac_ext <<_ACEOF
 /* confdefs.h.  */
 _ACEOF
@@ -13917,11 +13918,11 @@ cat >>conftest.$ac_ext <<_ACEOF
 #ifdef __cplusplus
 extern "C"
 #endif
-char EGifPutExtensionLast ();
+char EGifPutExtensionTrailer ();
 int
 main ()
 {
-return EGifPutExtensionLast ();
+return EGifPutExtensionTrailer ();
   ;
   return 0;
 }
@@ -23556,7 +23556,14 @@
 _ACEOF
 if (eval "$ac_cpp conftest.$ac_ext") 2>&5 |
   $EGREP "yes..yes" >/dev/null 2>&1; then
-  CPP_NEED_TRADITIONAL=no
+  # A cpp that leaves two dots alone can still break the Makefile.  Without
+  # -traditional it splices a backslash-newline and then splits the line
+  # again to keep the line numbering, and the backslash is gone: every
+  # continued variable definition and recipe in Makefile.in comes out as
+  # two lines, and GNU make 4 stops before building anything with
+  # "recipe commences before first target".  Ask for -traditional either
+  # way; it is what this Makefile.in has always been preprocessed with.
+  CPP_NEED_TRADITIONAL=yes
 else
   CPP_NEED_TRADITIONAL=yes
 fi
