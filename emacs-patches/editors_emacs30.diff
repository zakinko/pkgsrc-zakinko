diff -ruN -x CVS -x work /usr/pkgsrc/editors/emacs30/patches/patch-lisp_vc_vc-hooks.el editors/emacs30/patches/patch-lisp_vc_vc-hooks.el
--- /usr/pkgsrc/editors/emacs30/patches/patch-lisp_vc_vc-hooks.el	1970-01-01 00:00:00.000000000 +0000
+++ editors/emacs30/patches/patch-lisp_vc_vc-hooks.el	2026-09-21 13:34:06.386538690 +0000
@@ -0,0 +1,20 @@
+$NetBSD$
+
+Nullify read-symbol-shorthands around risky intern calls: a crafted file
+could run arbitrary Lisp when visited (debbugs 80574).
+From emacs commit 8466eb44991707d128110bdc549fad14c8e1d61e, via Gentoo/Debian.
+
+--- lisp/vc/vc-hooks.el.orig
++++ lisp/vc/vc-hooks.el
+@@ -234,7 +234,10 @@
+   "Return BACKEND-specific implementation of FUN.
+ If there is no such implementation, return the default implementation;
+ if that doesn't exist either, return nil."
+-  (let ((f (vc-make-backend-sym backend fun)))
++  ;; Nullify `read-symbol-shorthands' to guard the `intern' calls below
++  ;; and in `vc-make-backend-sym' from potentially malicious shorthands.
++  (let* ((read-symbol-shorthands nil)
++         (f (vc-make-backend-sym backend fun)))
+     (if (fboundp f) f
+       ;; Load vc-BACKEND.el if needed.
+       (require (intern (concat "vc-" (downcase (symbol-name backend)))))
diff -ruN -x CVS -x work /usr/pkgsrc/editors/emacs30/patches/patch-src_dispnew.c editors/emacs30/patches/patch-src_dispnew.c
--- /usr/pkgsrc/editors/emacs30/patches/patch-src_dispnew.c	1970-01-01 00:00:00.000000000 +0000
+++ editors/emacs30/patches/patch-src_dispnew.c	2026-09-21 13:34:06.387247719 +0000
@@ -0,0 +1,45 @@
+$NetBSD$
+
+With the pgtk toolkit, fall back to the terminal when no display
+(WAYLAND_DISPLAY, DISPLAY, BROADWAY_DISPLAY) is available instead of
+aborting.  From Fedora.
+
+--- src/dispnew.c.orig
++++ src/dispnew.c
+@@ -6557,10 +6557,33 @@ init_display_interactive (void)
+ #endif
+ 
+ #ifdef HAVE_PGTK
+-  if (!inhibit_window_system && !will_dump_p ())
++  if (!inhibit_window_system)
+     {
+-      Vinitial_window_system = Qpgtk;
+-      return;
++      if (!display_arg && !will_dump_p ())
++	{
++	  int i;
++	  const char *gdk_display_variables[] = {
++	    "WAYLAND_DISPLAY",
++	    "DISPLAY",
++	    "BROADWAY_DISPLAY",
++	  };
++	  size_t n = ARRAYELTS (gdk_display_variables);
++
++	  for (i = 0; i < n; i++)
++	    {
++	      char *display;
++	      display = getenv (gdk_display_variables[i]);
++	      if (display != 0 && *display != 0)
++		{
++		  display_arg = 1;
++		  break;
++		}
++	    }
++	}
++      if (display_arg) {
++	Vinitial_window_system = Qpgtk;
++	return;
++      }
+     }
+ #endif
+ 
diff -ruN -x CVS -x work /usr/pkgsrc/editors/emacs30/patches/patch-src_image.c editors/emacs30/patches/patch-src_image.c
--- /usr/pkgsrc/editors/emacs30/patches/patch-src_image.c	1970-01-01 00:00:00.000000000 +0000
+++ editors/emacs30/patches/patch-src_image.c	2026-09-21 13:53:20.657894128 +0000
@@ -0,0 +1,53 @@
+$NetBSD$
+
+CVE-2026-6861: svg_load_image wrote one byte past the CSS string
+(bug#80851).  From emacs upstream commit 8f535370b9efbc91673b20c6987a5cae4f6dc562, via Debian.
+
+CVE-2026-77219: integer overflow in the PBM/PPM/PGM loader let a crafted
+image read heap memory past the buffer (bug#81344).  From emacs commit
+b07e634e4cf45162ae0178e32092b040587f2c6c (in 31.0.91).
+
+--- src/image.c.orig
++++ src/image.c
+@@ -7701,19 +7701,22 @@
+     }
+   else
+     {
+-      int expected_size = height * width;
+       bool two_byte = 255 < max_color_idx;
+-      if (two_byte)
+-	expected_size *= 2;
+-      if (type == PBM_COLOR)
+-	expected_size *= 3;
+ 
+-      if (raw_p && p + expected_size > end)
++      if (raw_p)
+ 	{
+-	  image_destroy_x_image (ximg);
+-	  image_clear_image (f, img);
+-	  image_error ("Invalid image size in image `%s'", img->spec);
+-	  goto error;
++	  ptrdiff_t expected_size;
++	  bool bad = ckd_mul (&expected_size, height, width);
++	  bad |= ckd_mul (&expected_size, expected_size,
++			  (two_byte ? 2 : 1) * (type == PBM_COLOR ? 3 : 1));
++	  bad |= end - p < expected_size;
++	  if (bad)
++	    {
++	      image_destroy_x_image (ximg);
++	      image_clear_image (f, img);
++	      image_error ("Invalid image size in image `%s'", img->spec);
++	      goto error;
++	    }
+ 	}
+ 
+       for (y = 0; y < height; ++y)
+@@ -12052,7 +12055,7 @@
+     {
+       css = xmalloc (SBYTES (lcss) + 1);
+       strncpy (css, SSDATA (lcss), SBYTES (lcss));
+-      *(css + SBYTES (lcss) + 1) = 0;
++      *(css + SBYTES (lcss)) = 0;
+     }
+ #endif
+ 
