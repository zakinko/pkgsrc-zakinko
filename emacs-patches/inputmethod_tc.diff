diff -ruN -x CVS -x work /usr/pkgsrc/inputmethod/tc/patches/patch-lisp_tc-mkmzdic.el inputmethod/tc/patches/patch-lisp_tc-mkmzdic.el
--- /usr/pkgsrc/inputmethod/tc/patches/patch-lisp_tc-mkmzdic.el	1970-01-01 00:00:00.000000000 +0000
+++ inputmethod/tc/patches/patch-lisp_tc-mkmzdic.el	2026-09-21 20:26:09.436348371 +0000
@@ -0,0 +1,17 @@
+$NetBSD$
+
+An obarray is a vector of zeros, not of nils; Emacs 30 checks and refuses
+the latter, so the mazegaki dictionary could not be generated.  From
+Debian.
+
+--- lisp/tc-mkmzdic.el.orig	2003-03-25 15:00:00.000000000 +0000
++++ lisp/tc-mkmzdic.el
+@@ -107,7 +107,7 @@
+ (defvar tc-mkmzdic-obarray nil)
+ 
+ (defun tc-mkmzdic-init-obarray (size)
+-  (setq tc-mkmzdic-obarray (make-vector size nil)))
++  (setq tc-mkmzdic-obarray (make-vector size 0)))
+ 
+ (defun tc-mkmzdic-final-obarray ()
+   (setq tc-mkmzdic-obarray nil))
diff -ruN -x CVS -x work /usr/pkgsrc/inputmethod/tc/patches/patch-lisp_tc-sysdep.el inputmethod/tc/patches/patch-lisp_tc-sysdep.el
--- /usr/pkgsrc/inputmethod/tc/patches/patch-lisp_tc-sysdep.el	1970-01-01 00:00:00.000000000 +0000
+++ inputmethod/tc/patches/patch-lisp_tc-sysdep.el	2026-09-21 20:26:09.437102098 +0000
@@ -0,0 +1,31 @@
+$NetBSD$
+
+The Emacs 19-and-later branch was chosen by matching the version string
+against "19", "20" and "21", so Emacs 22 and later fell through to the
+NEmacs code, where tcode-redo-command sets unread-command-char, a
+variable modern Emacs does not have.  Test for NEmacs directly, as the
+rest of the file does.  The isearch shim read last-command-char, gone
+since Emacs 24; use last-command-event when it exists.
+
+--- lisp/tc-sysdep.el.orig	2003-03-25 15:00:00.000000000 +0000
++++ lisp/tc-sysdep.el
+@@ -228,7 +228,7 @@
+ ;;;
+ ;;; Fix incompatibilities between 18 and 19.
+ ;;;
+-(if (string-match "^\\(19\\|2[01]\\)" emacs-version)
++(if (not (tcode-nemacs-p))
+     (progn
+       (defun tcode-redo-command (ch)
+ 	"キー CH を現在のキーマップで再実行する"
+@@ -240,7 +240,9 @@
+       ;; XEmacs
+       (or (fboundp 'isearch-last-command-char)
+ 	  (defun isearch-last-command-char ()
+-	    last-command-char))
++	    (if (boundp 'last-command-event)
++		last-command-event
++	      last-command-char)))
+       (or (boundp 'search-upper-case)
+ 	  (setq search-upper-case 'not-yanks)))
+   ;; NEmacs
