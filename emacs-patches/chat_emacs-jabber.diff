diff -ruN -x CVS -x work /usr/pkgsrc/chat/emacs-jabber/patches/patch-Makefile.in chat/emacs-jabber/patches/patch-Makefile.in
--- /usr/pkgsrc/chat/emacs-jabber/patches/patch-Makefile.in	1970-01-01 00:00:00.000000000 +0000
+++ chat/emacs-jabber/patches/patch-Makefile.in	2026-09-21 14:01:03.204885156 +0000
@@ -0,0 +1,16 @@
+$NetBSD$
+
+batch-update-autoloads is gone in Emacs 30; use loaddefs-generate where
+it exists, and update-directory-autoloads before that.
+
+--- Makefile.in.orig
++++ Makefile.in
+@@ -1171,7 +1171,7 @@
+ # size, so we touch it with ancient timestamp.
+ jabber-autoloads.el: $(my_lisp_sources)
+ 	test -s $@ || cp -f $(srcdir)/jabber-autoloads.stub $@; touch -t 197001030000 $@
+-	$(EMACS) --batch --eval "(setq generated-autoload-file \"$(abs_builddir)/$@\")" -f batch-update-autoloads $(srcdir)
++	$(EMACS) --batch --eval "(let ((f \"$(abs_builddir)/$@\")) (if (fboundp 'loaddefs-generate) (loaddefs-generate \"$(srcdir)\" f) (setq generated-autoload-file f) (update-directory-autoloads \"$(srcdir)\")))"
+ elpa: dist
+ 	rm -rf emacs-jabber-$(PACKAGE_VERSION) jabber-$(PACKAGE_VERSION)
+ 	$(AMTAR) xzf emacs-jabber-$(PACKAGE_VERSION).tar.gz
