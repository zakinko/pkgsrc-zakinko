$NetBSD$

DTLS Connection IDs: RFC 9146, RFC 9853 and RFC 9147.
https://github.com/zakinko/openssl/tree/dtls-cid-series

--- include/openssl/ssl.h.in.orig
+++ include/openssl/ssl.h.in
@@ -858,6 +858,89 @@ void SSL_CTX_get0_alpn_protos(SSL_CTX *ctx, const unsigned char **protos,
 void SSL_get0_alpn_protos(SSL *ssl, const unsigned char **protos,
     unsigned int *protos_len);
 
+/**
+ * @def SSL_DTLS_CID_MAX_LEN
+ * The longest DTLS Connection ID, from opaque cid<0..2^8-1> (RFC 9146
+ * section 3).
+ */
+#define SSL_DTLS_CID_MAX_LEN 255
+
+/**
+ * @brief Enable the DTLS 1.2 "connection_id" extension and set the CID to
+ * receive.
+ * @param s the DTLS connection
+ * @param cid the CID the peer is asked to use when sending, or NULL
+ * @param cid_len the length of @p cid, at most SSL_DTLS_CID_MAX_LEN; 0 for
+ * none
+ * @returns 1 on success, 0 on error
+ * @see SSL_set1_dtls_cid(3)
+ */
+__owur int SSL_set1_dtls_cid(SSL *s, const unsigned char *cid, size_t cid_len);
+
+/**
+ * @brief Disable the DTLS 1.2 "connection_id" extension from the next
+ * handshake on.
+ * @param s the DTLS connection
+ * @see SSL_clear_dtls_cid(3)
+ */
+void SSL_clear_dtls_cid(SSL *s);
+
+/**
+ * @brief Get the Connection IDs negotiated in the last handshake.
+ * @param s the DTLS connection
+ * @param own set to the CID in the records @p s receives, may be NULL
+ * @param own_len set to the length of @p own, may be NULL
+ * @param peer set to the CID in the records @p s sends, may be NULL
+ * @param peer_len set to the length of @p peer, may be NULL
+ * @returns 1 if the extension was negotiated, 0 otherwise
+ * @see SSL_get0_dtls_cid(3)
+ */
+int SSL_get0_dtls_cid(const SSL *s, const unsigned char **own,
+    size_t *own_len, const unsigned char **peer, size_t *peer_len);
+
+/**
+ * @brief Offer or accept the Return Routability Check (RFC 9853) along with
+ * the DTLS Connection ID; on by default.
+ * @param s the DTLS connection
+ * @param enable 1 to use it, 0 not to
+ * @returns 1 on success, 0 on error
+ * @see SSL_set_dtls_rrc(3)
+ */
+int SSL_set_dtls_rrc(SSL *s, int enable);
+
+/**
+ * @brief Tell whether the Return Routability Check was negotiated in the
+ * last handshake.
+ * @param s the DTLS connection
+ * @returns 1 if it was, 0 otherwise
+ * @see SSL_get_dtls_rrc(3)
+ */
+int SSL_get_dtls_rrc(const SSL *s);
+
+/* RFC 9147 section 9, ConnectionIdUsage */
+#define SSL_DTLS_CID_IMMEDIATE 0
+#define SSL_DTLS_CID_SPARE 1
+
+/**
+ * @brief Send the peer a new CID to use when sending to us, in a DTLS 1.3
+ * NewConnectionId message (RFC 9147 section 9).
+ * @param s the DTLS 1.3 connection
+ * @param usage SSL_DTLS_CID_IMMEDIATE or SSL_DTLS_CID_SPARE
+ * @returns 1 if the message is queued, 0 on error
+ * @see SSL_dtls_new_connection_id(3)
+ */
+int SSL_dtls_new_connection_id(SSL *s, int usage);
+
+/**
+ * @brief Ask the peer for spare CIDs in a DTLS 1.3 RequestConnectionId
+ * message (RFC 9147 section 9).
+ * @param s the DTLS 1.3 connection
+ * @param num the number of CIDs wanted, 1 to 255
+ * @returns 1 if the message is queued, 0 on error
+ * @see SSL_dtls_request_connection_id(3)
+ */
+int SSL_dtls_request_connection_id(SSL *s, unsigned int num);
+
 #ifndef OPENSSL_NO_PSK
 /*
  * the maximum length of the buffer given to callbacks containing the
@@ -1101,7 +1184,15 @@ typedef enum {
     TLS_ST_CR_ACK,
     TLS_ST_CW_ACK,
     TLS_ST_SR_ACK,
-    TLS_ST_SW_ACK
+    TLS_ST_SW_ACK,
+    TLS_ST_CR_NEW_CONNECTION_ID,
+    TLS_ST_CW_NEW_CONNECTION_ID,
+    TLS_ST_SR_NEW_CONNECTION_ID,
+    TLS_ST_SW_NEW_CONNECTION_ID,
+    TLS_ST_CR_REQUEST_CONNECTION_ID,
+    TLS_ST_CW_REQUEST_CONNECTION_ID,
+    TLS_ST_SR_REQUEST_CONNECTION_ID,
+    TLS_ST_SW_REQUEST_CONNECTION_ID
 } OSSL_HANDSHAKE_STATE;
 
 /*
@@ -1967,6 +2058,30 @@ typedef int (*SSL_new_pending_conn_cb_fn)(SSL_CTX *ctx, SSL *new_ssl,
 void SSL_CTX_set_new_pending_conn_cb(SSL_CTX *c, SSL_new_pending_conn_cb_fn cb,
     void *arg);
 
+/**
+ * @brief Callback asked whether a DTLS connection may send to a new peer
+ * address (RFC 9146 section 6).
+ * @param s the connection
+ * @param old_addr the address the connection sends to now
+ * @param new_addr the source of a newer record that passed verification
+ * @param arg the argument given to SSL_CTX_set_dtls_peer_addr_change_cb()
+ * @returns 1 to send to @p new_addr from now on, 0 to keep @p old_addr
+ * @see SSL_CTX_set_dtls_peer_addr_change_cb(3)
+ */
+typedef int (*SSL_dtls_peer_addr_change_cb_fn)(SSL *s,
+    const BIO_ADDR *old_addr, const BIO_ADDR *new_addr, void *arg);
+
+/**
+ * @brief Set the callback that decides DTLS peer address changes for
+ * connections made from @p c by a DTLS listener.
+ * @param c the SSL_CTX
+ * @param cb the callback, or NULL to never change the address
+ * @param arg passed to @p cb
+ * @see SSL_CTX_set_dtls_peer_addr_change_cb(3)
+ */
+void SSL_CTX_set_dtls_peer_addr_change_cb(SSL_CTX *c,
+    SSL_dtls_peer_addr_change_cb_fn cb, void *arg);
+
 #ifndef OPENSSL_NO_DEPRECATED_4_0
 OSSL_DEPRECATEDIN_4_0 int SSL_client_hello_isv2(SSL *s);
 #endif
@@ -2459,6 +2574,7 @@ __owur int SSL_get_conn_close_info(SSL *ssl,
 #define SSL_VALUE_DTLS_LISTENER_MAX_PENDING_CONNS 17
 #define SSL_VALUE_DTLS_LISTENER_PENDING_TIMEOUT 18
 #define SSL_VALUE_DTLS_LISTENER_MAX_DGRAM_SIZE 19
+#define SSL_VALUE_DTLS_LISTENER_CID_LEN 20
 
 #define SSL_VALUE_EVENT_HANDLING_MODE_INHERIT 0
 #define SSL_VALUE_EVENT_HANDLING_MODE_IMPLICIT 1
