--- configure.in.orig	2009-09-13 10:00:15.000000000 +0900
+++ configure.in
@@ -278,9 +278,9 @@ dnl see the `changequote' comment above.
       m68k-*-netbsd*)
 			# This is somewhat bogus.
 			machine=hp9000s300 ;;
-      mips-*-netbsd*)	machine=pmax ;;
-      mipsel-*-netbsd*)	machine=pmax ;;
-      mipseb-*-netbsd*)	machine=pmax ;;
+      mips-*-netbsd*)	machine=mips ;;
+      mipsel-*-netbsd*)	machine=mips ;;
+      mipseb-*-netbsd*)	machine=mips ;;
       ns32k-*-netbsd*)	machine=ns32000 ;;
       powerpc-*-netbsd*) machine=macppc ;;
       sparc*-*-netbsd*)	machine=sparc ;;

+++ configure
@@ -23556,7 +23556,14 @@
 _ACEOF
 if (eval "$ac_cpp conftest.$ac_ext") 2>&5 |
   $EGREP "yes..yes" >/dev/null 2>&1; then
-  CPP_NEED_TRADITIONAL=no
+  # A cpp that leaves two dots alone can still break the Makefile.  Without
+  # -traditional it splices a backslash-newline and then splits the line
+  # again to keep the line numbering, and the backslash is gone: every
+  # continued variable definition and recipe in Makefile.in comes out as
+  # two lines, and GNU make 4 stops before building anything with
+  # "recipe commences before first target".  Ask for -traditional either
+  # way; it is what this Makefile.in has always been preprocessed with.
+  CPP_NEED_TRADITIONAL=yes
 else
   CPP_NEED_TRADITIONAL=yes
 fi
