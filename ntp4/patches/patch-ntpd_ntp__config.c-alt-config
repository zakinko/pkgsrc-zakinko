$NetBSD$

* Changes from NetBSD base.
* Try ALT_CONFIG_FILE when CONFIG_FILE cannot be opened and no -c option
  was given: pkgsrc relocates CONFIG_FILE to ${PKG_SYSCONFDIR}/ntp.conf,
  and without the fallback an existing /etc/ntp.conf would silently stop
  being read (PR pkg/47149).  Only applies when -DALT_CONFIG_FILE is
  set; a package that does not relocate CONFIG_FILE need not carry this
  patch.  Applies on top of patch-ntpd_ntp__config.c.

--- ntpd/ntp_config.c.orig	2020-06-23 16:03:47.000000000 +0000
+++ ntpd/ntp_config.c
@@ -4990,9 +4990,32 @@ getconfig(
 		) {
 		msyslog(LOG_INFO, "getconfig: Couldn't open <%s>: %m", FindConfig(config_file));
 #ifndef SYS_WINNT
+#ifdef ALT_CONFIG_FILE
+		/*
+		 * CONFIG_FILE may be relocated at build time (pkgsrc
+		 * sets it to ${PKG_SYSCONFDIR}/ntp.conf).  Try the
+		 * historic location before giving up, so an existing
+		 * /etc/ntp.conf keeps working.  An explicit -c on the
+		 * command line never falls back.
+		 */
+		if (HAVE_OPT( CONFIGFILE ) ||
+		    !lex_init_stack(FindConfig(ALT_CONFIG_FILE), "r")) {
+			if (!HAVE_OPT( CONFIGFILE ))
+				msyslog(LOG_INFO,
+					"getconfig: Couldn't open <%s>: %m",
+					FindConfig(ALT_CONFIG_FILE));
+			io_open_sockets();
+
+			return;
+		}
+		msyslog(LOG_INFO, "getconfig: Using <%s>",
+			FindConfig(ALT_CONFIG_FILE));
+		cfgt.source.value.s = estrdup(ALT_CONFIG_FILE);
+#else	/* !ALT_CONFIG_FILE */
 		io_open_sockets();

 		return;
+#endif	/* !ALT_CONFIG_FILE */
 #else
 		/* Under WinNT try alternate_config_file name, first NTP.CONF, then NTP.INI */

