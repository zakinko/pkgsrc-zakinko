$NetBSD$

Let the bzlmod graph resolve under bazel 9.

3.33 pins rules_cc to 0.2.2 with a single_version_override.  That release
still carries cc/private/rules_impl/native.bzl, which reads the CcInfo,
DebugPackageInfo and CcSharedLibraryInfo globals bazel 9 removed, so the
build dies in the loading phase before any target is analysed.  0.2.17 is
the first release without that file, and no release takes both it and the
override's three patches: they stop applying at 0.2.15.  The patches only
add an x64_x86_windows clang-cl toolchain, which .bazelrc registers under
windows_env alone, so dropping the override costs nothing here.

googletest and the rules_android/rules_go pair reached through protobuf are
the same versions upstream moved to for bazel 9 in 3.34.

The abseil-cpp override carries abseil/abseil-cpp#2160.  bzlmod takes
abseil from the registry rather than from third_party/, so the
patches/patch-abseil2160-* that fix the gyp build never reach this one;
the same change is applied here from toolchain_local/, which post-extract
copies into the workspace.

--- MODULE.bazel.orig
+++ MODULE.bazel
@@ -37,6 +37,24 @@
     repo_name = "com_google_absl",
 )
 
+# abseil/abseil-cpp#2160: DragonFly is on none of the platform lists, and
+# the one in raw_logging.cc lacks NetBSD as well, so ABSL_RAW_LOG writes
+# nothing there.  The gyp build gets the same change from patches/.
+# 20250814.1, not the .0 named above: .0 has no load() for cc_library
+# and bazel 9 rejects it, and .1 is what the graph resolves to anyway.
+single_version_override(
+    module_name = "abseil-cpp",
+    version = "20250814.1",
+    patch_strip = 1,
+    patches = [
+        "//toolchain_local:abseil2160-absl_base_config.h.patch",
+        "//toolchain_local:abseil2160-absl_base_internal_raw__logging.cc.patch",
+        "//toolchain_local:abseil2160-absl_base_internal_sysinfo.cc.patch",
+        "//toolchain_local:abseil2160-absl_debugging_internal_vdso__support.cc.patch",
+        "//toolchain_local:abseil2160-absl_time_internal_cctz_src_time__zone__format.cc.patch",
+    ],
+)
+
 # protobuf: 32.0 2025-08-15
 # https://github.com/protocolbuffers/protobuf
 bazel_dep(
@@ -49,7 +67,7 @@
 # https://github.com/google/googletest
 bazel_dep(
     name = "googletest",
-    version = "1.17.0",
+    version = "1.17.0.bcr.2",
     repo_name = "com_google_googletest",
 )
 
@@ -123,18 +141,26 @@
 # https://github.com/bazelbuild/rules_cc/
 bazel_dep(
     name = "rules_cc",
-    version = "0.2.2",
+    version = "0.2.17",
 )
-single_version_override(
-    module_name = "rules_cc",
-    patches = [
-        # Enable to build x86 (32-bit) executables with clang-cl.
-        # https://github.com/bazelbuild/rules_cc/pull/360
-        "bazel/rules_cc_BUILD.windows.tpl.patch",
-        "bazel/rules_cc_windows_cc_configure.bzl.patch",
-        "bazel/rules_cc_windows_cc_toolchain_config.bzl.patch",
-    ],
-    version = "0.2.2",
+
+# protobuf -> rules_jvm_external -> rules_android -> rules_go, none of which
+# support bazel 9 at the versions the graph picks on its own
+bazel_dep(
+    name = "rules_go",
+    version = "0.60.0",
+    repo_name = "io_bazel_rules_go",
+)
+
+bazel_dep(
+    name = "gazelle",
+    version = "0.48.0",
+    repo_name = "bazel_gazelle",
+)
+
+bazel_dep(
+    name = "rules_android",
+    version = "0.7.1",
 )
 
 cc_configure = use_extension(
