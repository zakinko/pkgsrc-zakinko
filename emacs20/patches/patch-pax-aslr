$NetBSD$

Turn ASLR off for temacs and for the dumped emacs.

unexec writes the running image back out as an executable, so the addresses it
recorded have to be the addresses it gets next time.  NetBSD randomises them:

	security.pax.aslr.global = 1

is the default.  What that produces is not a clean failure but a crash at a
different place every time -- while temacs runs loadup, while the dumped emacs
byte-compiles, or later at startup.

paxctl marks the flag in the ELF header, so the dumped emacs carries it through
installation.  || true keeps the build working where paxctl is not there, which
is every platform except NetBSD.

--- src/Makefile.in.orig	2016-11-26 06:25:26.875919180 +0000
+++ src/Makefile.in
@@ -823,6 +816,7 @@ emacs: temacs ${etc}DOC ${lisp}
 #else /* ! defined (HAVE_SHM) */
 	./temacs -batch -l loadup dump
 #endif /* ! defined (HAVE_SHM) */
+	/usr/sbin/paxctl +a emacs || true
 #endif /* ! defined (CANNOT_DUMP) */
 	-./emacs -q -batch -f list-load-path-shadows
 
@@ -851,6 +845,7 @@ temacs: MAKE_PARALLEL $(LOCALCPP) $(STAR
 	$(LD) YMF_PASS_LDFLAGS (${STARTFLAGS} ${ALL_LDFLAGS}) \
     -o temacs ${STARTFILES} ${obj} ${otherobj}  \
     OBJECTS_SYSTEM OBJECTS_MACHINE ${LIBES}
+	/usr/sbin/paxctl +a temacs || true
 
 /* We don't use ALL_LDFLAGS because LD_SWITCH_SYSTEM and LD_SWITCH_MACHINE
    often contain options that have to do with using Emacs's crt0,
