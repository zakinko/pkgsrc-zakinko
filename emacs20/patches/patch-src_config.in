$NetBSD$

config.in is maintained by hand here, not generated by autoheader.  configure
tests for getaddrinfo and calls AC_DEFINE, but with no #undef line to rewrite
the result is dropped, so the IPv6-capable resolver path is never compiled in.

--- src/config.in.orig	Sat May 20 23:58:21 2000
+++ src/config.in	Sun Jun 18 09:00:34 2000
@@ -236,6 +236,7 @@
 #undef HAVE_STRFTIME
 #undef HAVE_GRANTPT
 #undef HAVE_GETPT
+#undef HAVE_GETADDRINFO
 
 #undef LOCALTIME_CACHE
 #undef HAVE_INET_SOCKETS
