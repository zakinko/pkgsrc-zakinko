$NetBSD$

/tmp/geta$$ is a name an attacker can guess and create first, as a symlink to
somewhere else.  vcdiff runs as the user, so the redirection then writes
through it.  mktemp picks an unpredictable name and creates the file itself.

--- lib-src/vcdiff.orig	1997-01-01 00:33:42.000000000 -0500
+++ lib-src/vcdiff	2008-07-13 13:31:27.000000000 -0400
@@ -66,14 +66,14 @@
 	case $f in
 	s.* | */s.*)
 		if
-			rev1=/tmp/geta$$
+			rev1=`mktemp /tmp/geta.XXXXXXXX`
 			get -s -p -k $sid1 "$f" > $rev1 &&
 			case $sid2 in
 			'')
 				workfile=`expr " /$f" : '.*/s.\(.*\)'`
 				;;
 			*)
-				rev2=/tmp/getb$$
+				rev2=`mktemp /tmp/getb.XXXXXXXX`
 				get -s -p -k $sid2 "$f" > $rev2
 				workfile=$rev2
 			esac
