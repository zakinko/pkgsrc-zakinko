--- lang/rust-bin/Makefile.orig
+++ lang/rust-bin/Makefile
@@ -33,8 +33,12 @@
 ONLY_FOR_PLATFORM+=	NetBSD-*-mipsel
 ONLY_FOR_PLATFORM+=	NetBSD-*-riscv64
 
-# Illumos, jperkin@ provided binaries
+# Upstream publishes an illumos binary.  Solaris is not illumos and cannot
+# run it, and OS_VARIANT is the variable that tells them apart, so the entry
+# has to be added conditionally rather than written as a platform glob.
+.if ${OS_VARIANT} != "Solaris"
 ONLY_FOR_PLATFORM+=	SunOS-*-x86_64
+.endif
 
 NETBSD_REPO=	https://cdn.NetBSD.org/pub/pkgsrc/distfiles/LOCAL_PORTS/rust/
 
@@ -104,6 +108,11 @@
 RUST_ARCH:=	x86_64-unknown-netbsd
 DISTFILES:=	${DISTFILES} ${DISTNAME}-${RUST_ARCH}.tar.gz
 .endif
+.if (${MACHINE_PLATFORM:MSunOS-*-x86_64} && ${OS_VARIANT} != "Solaris") || \
+    make(distinfo) || make(makesum) || make(mdi)
+RUST_ARCH:=	x86_64-unknown-illumos
+DISTFILES:=	${DISTFILES} ${DISTNAME}-${RUST_ARCH}.tar.gz
+.endif
 
 # NetBSD provided binaries:
 
@@ -182,17 +191,7 @@
 SITES.${DF}=	${NETBSD_REPO}
 .endif
 
-# Illumos:
-#.if ${MACHINE_PLATFORM:MSunOS-*-x86_64} || make(distinfo) || make(makesum) || make(mdi)
-#RUST_ARCH:=	x86_64-unknown-illumos
-#DN:=		${DISTNAME}
-#EXTRACT_SUFX=	.tar.gz
-#DF:=		${DN}-${RUST_ARCH}${EXTRACT_SUFX}
-#DISTFILES:=	${DISTFILES} ${DF}
-#SITES.${DF}=	https://us-central.manta.mnx.io/pkgsrc/public/pkg-bootstraps/
-#.endif
 
-
 # Binary still extracts to plain non-nb'ed directory
 WRKSRC:=	${WRKSRC:C/nb[0-9]*//}
 WRKSRC:=	${WRKSRC:C/-$//}
