--- pkgtools/libnbcompat/files/nbcompat/time.h.orig
+++ pkgtools/libnbcompat/files/nbcompat/time.h
@@ -64,6 +64,17 @@
 int utimes(const char *, const struct timeval *);
 #endif
 
+/*
+ * lutimes.c is built whenever the host lacks lutimes(2), but nothing declared
+ * it.  The guard has to be HAVE_DECL_LUTIMES, not HAVE_LUTIMES: a caller that
+ * links against the replacement gets HAVE_LUTIMES=1 from its own configure,
+ * so keying on that suppresses the declaration in exactly the case that needs
+ * it.  archivers/pax on Solaris is where this shows up.
+ */
+#if !HAVE_DECL_LUTIMES
+int lutimes(const char *, const struct timeval *);
+#endif
