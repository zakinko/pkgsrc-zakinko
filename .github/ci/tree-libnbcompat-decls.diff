@@ -295,6 +295,20 @@
              #include <stdio.h>])
 AC_CHECK_DECLS([strdup(const char *)],
             [], [AC_LIBOBJ(strdup)], [#include <string.h>])
+
+# lutimes and lchflags are in AC_REPLACE_FUNCS below, so on a host without
+# them a caller links against the replacement here -- and that caller's own
+# configure then finds the symbol and defines ITS HAVE_LUTIMES.  What no
+# header supplies on such a host is the declaration, which is a different
+# question from whether the function exists, and the one AC_CHECK_DECLS asks.
+# archivers/pax hits exactly this on Solaris: its file_subs.c guards the call
+# with #if HAVE_LUTIMES, that is true, and the call is then an implicit
+# declaration, which is an error with the compilers that now default to
+# -Werror=implicit-function-declaration.
+AC_CHECK_DECLS([lutimes(const char *, const struct timeval *)],
+            [], [], [#include <sys/time.h>])
+AC_CHECK_DECLS([lchflags(const char *, unsigned long)],
+            [], [], [#include <sys/stat.h>])
 
 case $host_os in
