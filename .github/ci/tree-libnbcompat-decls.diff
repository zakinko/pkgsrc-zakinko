--- pkgtools/libnbcompat/files/configure.orig
+++ pkgtools/libnbcompat/files/configure
@@ -6984,6 +6984,35 @@
 fi
 
 
+# lutimes and lchflags are in AC_REPLACE_FUNCS below, so on a host without
+# them a caller links against the replacement here, and that caller's own
+# configure then defines ITS HAVE_LUTIMES.  The missing thing is the
+# declaration, which AC_CHECK_DECLS is what asks about.
+as_ac_Symbol=`printf "%s\n" "ac_cv_have_decl_lutimes(const char *, const struct timeval *)" | sed "$as_sed_sh"`
+ac_fn_check_decl "$LINENO" "lutimes(const char *, const struct timeval *)" "$as_ac_Symbol" "#include <sys/time.h>
+" "$ac_c_undeclared_builtin_options" "CFLAGS"
+if eval test \"x\$"$as_ac_Symbol"\" = x"yes"
+then :
+  ac_have_decl=1
+else case e in #(
+  e) ac_have_decl=0 ;;
+esac
+fi
+printf "%s\n" "#define HAVE_DECL_LUTIMES $ac_have_decl" >>confdefs.h
+
+as_ac_Symbol=`printf "%s\n" "ac_cv_have_decl_lchflags(const char *, unsigned long)" | sed "$as_sed_sh"`
+ac_fn_check_decl "$LINENO" "lchflags(const char *, unsigned long)" "$as_ac_Symbol" "#include <sys/stat.h>
+" "$ac_c_undeclared_builtin_options" "CFLAGS"
+if eval test \"x\$"$as_ac_Symbol"\" = x"yes"
+then :
+  ac_have_decl=1
+else case e in #(
+  e) ac_have_decl=0 ;;
+esac
+fi
+printf "%s\n" "#define HAVE_DECL_LCHFLAGS $ac_have_decl" >>confdefs.h
+
+
