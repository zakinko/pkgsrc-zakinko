+# Upstream builds x86_64-unknown-illumos and x86_64-pc-solaris separately, and
+# OS_VARIANT is what distinguishes the two on an otherwise identical
+# MACHINE_PLATFORM.  OS_VARIANT is only set on SunOS, hence the :U.
+.if (${MACHINE_PLATFORM:MSunOS-*-x86_64} && ${OS_VARIANT:U} != "Solaris") || \
+    make(distinfo) || make(makesum) || make(mdi)
+RUST_ARCH:=	x86_64-unknown-illumos
+DISTFILES:=	${DISTFILES} ${DISTNAME}-${RUST_ARCH}.tar.gz
+.endif
+.if (${MACHINE_PLATFORM:MSunOS-*-x86_64} && ${OS_VARIANT:U} == "Solaris") || \
+    make(distinfo) || make(makesum) || make(mdi)
+RUST_ARCH:=	x86_64-pc-solaris
