@@ -207,6 +194,11 @@
 	${RM} -f ${DESTDIR}${PREFIX}/lib/rustlib/uninstall.sh
 
 .if ${OPSYS} == "Darwin"
+# The dylibs under lib/rustlib/<target>/ keep the install name they ship with
+# (see fix-darwin-install-name below), which the shlib check cannot resolve;
+# they are found through LC_RPATH at run time.  A * matches a slash here.
+CHECK_SHLIBS_SKIP+=	lib/rustlib/*/lib/*.dylib
+
 .PHONY: fix-darwin-install-name
 post-install: fix-darwin-install-name
 fix-darwin-install-name:
@@ -235,10 +227,39 @@
 		    ${DESTDIR}${PREFIX}/lib/rustlib/${RUST_ARCH}/bin/${bin}; \
 	done
 .  endfor
-.  for lib in lib lib/rustlib/${RUST_ARCH}/lib lib/rustlib/${RUST_ARCH}/codegen-backends
+# Only the dylibs directly under ${PREFIX}/lib.  The ones below
+# lib/rustlib/<target>/ keep the install name they ship with, because the
+# rewrite does not fit in the x86_64 build and is not needed for the program
+# to run.
+#
+# It does not fit: install_name_tool accepts an id of at most 71 characters in
+# those dylibs, and ${PREFIX}/lib/rustlib/x86_64-apple-darwin/lib/libstd-<hash>
+# .dylib is 74.  The arm64 build has room for 87, which is why only x86_64 ever
+# showed it.  Worse, install_name_tool reports
+#     error: ... can't be redone ... because larger updated load commands do
+#     not fit (the program must be relinked, ...)
+# and exits 0, so the rewrite was skipped in silence and the failure surfaced
+# much later as
+#     pkg_add: rust-bin-1.96.1: missing required library: @rpath/libstd-...
+#
+# It is not needed: bin/rustc carries LC_RPATH @loader_path/../lib, which from
+# ${PREFIX}/bin resolves to ${PREFIX}/lib, exactly where the dylibs land, and
+# the ones under lib/rustlib are reached the same way.  None of them has an
+# @rpath dependency other than its own id, so the -change loop had nothing to
+# do there either.  codegen-backends does not exist in the darwin tarballs.
+#
+# Check the id we do ask for actually landed.  A silent skip here would be the
+# same trap one directory up.
+.  for lib in lib
 	for f in ${DESTDIR}${PREFIX}/${lib}/lib*.dylib; do		\
 		[ ! -f $$f ] && continue;				\
-		install_name_tool -id `${ECHO} $$f | ${SED} -e 's,${DESTDIR},,g'` $$f; \
+		want=`${ECHO} $$f | ${SED} -e 's,${DESTDIR},,g'`;	\
+		install_name_tool -id $$want $$f;			\
+		got=`otool -D $$f | tail -1`;				\
+		if [ "$$got" != "$$want" ]; then			\
+			${ECHO} "install_name_tool did not set $$want (got $$got)" 1>&2; \
+			exit 1;						\
+		fi;							\
 		otool -XL $$f | grep '@rpath' | while read rpath rest; do \
 			install_name_tool -change $$rpath \
 			    `${ECHO} $$rpath | ${SED} -e 's,@rpath,${PREFIX}/lib,g'` \
@@ -254,11 +275,20 @@
 RUST_LLVM_RPATH=	${PREFIX}/lib
 FORCE_RPATH=		--force-rpath
 
-# 32-bit NetBSD ports need libatomic
+# These ports need libatomic.  The 32-bit ones need it for 64-bit atomics;
+# riscv64 needs it although it is 64-bit, because the compiler turns sub-word
+# atomics into libatomic calls there.  Without this the installed rustc does
+# not start:
+#
+#   librustc_driver-*.so: Shared object "libatomic.so.3" not found
+#
+# NetBSD ships no libatomic in base on any architecture, so nothing else
+# supplies it.
 .  if ${MACHINE_PLATFORM:MNetBSD-*-powerpc} || \
       ${MACHINE_PLATFORM:MNetBSD-*-earmv[67]hf} || \
       ${MACHINE_PLATFORM:MNetBSD-*-mipsel} || \
-      ${MACHINE_PLATFORM:MNetBSD-*-i386}
+      ${MACHINE_PLATFORM:MNetBSD-*-i386} || \
+      ${MACHINE_PLATFORM:MNetBSD-*-riscv64}
 .    include "../../devel/libatomic/buildlink3.mk"
 .  endif
 
