--- pkgtools/libnbcompat/files/configure.orig
+++ pkgtools/libnbcompat/files/configure
@@ -7013,6 +7013,16 @@
 esac
  ;;
 esac
+fi
+
+
+# lchflags.c calls chflags(2) when it has to emulate lchflags(2).  Only the
+# BSDs have it, so ask for it rather than listing the systems that do not.
+ac_fn_c_check_func "$LINENO" "chflags" "ac_cv_func_chflags"
+if test "x$ac_cv_func_chflags" = xyes
+then :
+  printf "%s\n" "#define HAVE_CHFLAGS 1" >>confdefs.h
+
 fi
 
 
--- pkgtools/libnbcompat/files/lchflags.c.orig
+++ pkgtools/libnbcompat/files/lchflags.c
@@ -48,10 +48,18 @@
 	if (S_ISLNK(psb.st_mode)) {
 		return 0;
 	}
-#if defined(__illumos__) || defined(__linux__)
+	/*
+	 * Ask whether the system has chflags(2), rather than naming the
+	 * ones that do not.  The list was __illumos__ and __linux__, and
+	 * Solaris is neither, so it fell through to the call and the
+	 * bootstrap stopped with "implicit declaration of function
+	 * 'chflags'".  Any other system without it would have done the
+	 * same on its first build.
+	 */
+#if HAVE_CHFLAGS
+	return (chflags(path, flags));
+#else
 	errno = (path == NULL ? EINVAL : ENOSYS);
 	return -1;
-#else
-	return (chflags(path, flags));
 #endif
 }
