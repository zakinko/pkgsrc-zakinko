--- /dev/null
+++ devel/pkgconf/patches/patch-cli_core.c
@@ -0,0 +1,33 @@
+$NetBSD$
+
+Do not hand an unchecked fopen() result to fclose().
+
+When errors are silenced, the null device is opened and a flag is set
+without looking at whether the open succeeded.  On OpenBSD the open fails
+with ENOENT whenever an unveil has already been taken (see the main.c
+patch), and pkgconf_cli_state_reset() then calls fclose(NULL), which is a
+SIGSEGV rather than a diagnostic.  Keep stderr when it cannot be opened.
+
+--- cli/core.c.orig	2026-09-23 05:27:43.000000000 +0000
++++ cli/core.c
+@@ -1097,8 +1097,18 @@
+ 	if ((state->want_flags & PKG_ERRORS_ON_STDOUT) == PKG_ERRORS_ON_STDOUT)
+ 		state->error_msgout = stdout;
+ 	if ((state->want_flags & PKG_SILENCE_ERRORS) == PKG_SILENCE_ERRORS) {
+-		state->error_msgout = fopen(PATH_DEV_NULL, "w");
+-		state->opened_error_msgout = true;
++		FILE *devnull = fopen(PATH_DEV_NULL, "w");
++
++		/*
++		 * Keep stderr if the null device cannot be opened.  Setting the flag
++		 * without looking at the result left a NULL pointer to be handed to
++		 * fclose() in pkgconf_cli_state_reset(), which is a crash rather than
++		 * a diagnostic.
++		 */
++		if (devnull != NULL) {
++			state->error_msgout = devnull;
++			state->opened_error_msgout = true;
++		}
+ 	}
+ 
+ 	if ((state->want_flags & PKG_IGNORE_CONFLICTS) == PKG_IGNORE_CONFLICTS || pkgconf_client_getenv(&state->pkg_client, "PKG_CONFIG_IGNORE_CONFLICTS") != NULL)
--- /dev/null
+++ devel/pkgconf/patches/patch-cli_main.c
@@ -0,0 +1,37 @@
+$NetBSD$
+
+Open the audit log before taking any unveil.
+
+unveil() hides everything that has not been unveiled yet, and the
+pkg-config search directories are not unveiled until the directory list
+has been built -- which lstat()s each one and silently drops the ones it
+cannot see.  With PKG_CONFIG_LOG set, which pkgsrc always sets, every
+lookup on OpenBSD therefore returns NOT-FOUND, and configure scripts stop
+with "pkg-config not found".  The unveil bought nothing here: the file is
+opened immediately afterwards, and the descriptor stays usable whatever is
+unveiled later.
+
+--- cli/main.c.orig	2026-09-23 05:27:43.000000000 +0000
++++ cli/main.c
+@@ -513,12 +513,15 @@
+ 
+ 	if (logfile_arg != NULL)
+ 	{
+-		if (pkgconf_unveil(logfile_arg, "rwc") == -1)
+-		{
+-			pkgconf_output_file_fmt(stderr, "pkgconf: unveil failed: %s\n", strerror(errno));
+-			return EXIT_FAILURE;
+-		}
+-
++		/*
++		 * Open the log before any unveil is taken.  The first unveil() call
++		 * hides everything that has not been unveiled yet, and the search
++		 * directories are not unveiled until the dir list has been built --
++		 * which lstat()s each one and drops the ones it cannot see, so every
++		 * lookup then returns NOT-FOUND.  Unveiling the log here and opening
++		 * it right afterwards bought nothing: once the file is open the
++		 * descriptor stays usable whatever is unveiled later.
++		 */
+ 		state.logfile_out = fopen(logfile_arg, "a");
+ 		pkgconf_audit_set_log(&state.pkg_client, state.logfile_out);
+ 	}
