--- devel/ncurses/Makefile.orig
+++ devel/ncurses/Makefile
@@ -44,6 +44,13 @@
 CONFIGURE_ARGS.Darwin+=	--disable-mixed-case
 CONFIGURE_ARGS.SunOS+=	--disable-const
 
+# configure probes the linker search path by running "ldconfig -v".  On
+# OpenBSD that does not list anything, it rewrites /var/run/ld.so.hints
+# with only /usr/lib when run as root, and every binary under /usr/local
+# then fails to load its libraries.  The answer it arrives at there is
+# /usr/lib anyway, so give it that and skip the probe.
+CONFIGURE_ENV.OpenBSD+=	cf_cv_ld_searchpath=/usr/lib
+
 CONFIGURE_ARGS.UnixWare+=	--disable-libtool-version
 
 # QNX libc is missing some functions.
