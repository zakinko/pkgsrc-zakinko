diff -ruN orig/lang/go/version.mk new/lang/go/version.mk
--- orig/lang/go/version.mk	2026-09-18 12:43:31
+++ new/lang/go/version.mk	2026-09-18 12:44:20
@@ -26,11 +26,23 @@
 GOVERSSUFFIX=		${GO_VERSION_DEFAULT}
 .endif
 
-# How to find the Go tool
-GO=			${TOOLBASE}/go${GOVERSSUFFIX}/bin/go
+# GO_TYPE selects which Go toolchain builds Go packages: "src" is the
+# lang/go${GOVERSSUFFIX} package, built from source, and "bin" is the
+# upstream binary release from lang/go-bin.  A package that pins a
+# particular release with GO_VERSION_REQD needs that release and stays
+# on "src".
+GO_TYPE?=		src
 
-# Build dependency for Go
+.if ${GO_TYPE} == "bin" && !defined(GO_VERSION_REQD)
+GO_DIR=			go-bin
+GO_PACKAGE_DEP=		go-bin>=${GO${GOVERSSUFFIX}_VERSION:R}:../../lang/go-bin
+.else
+GO_DIR=			go${GOVERSSUFFIX}
 GO_PACKAGE_DEP=		go${GOVERSSUFFIX}-${GO${GOVERSSUFFIX}_VERSION}*:../../lang/go${GOVERSSUFFIX}
+.endif
+
+# How to find the Go tool
+GO=			${TOOLBASE}/${GO_DIR}/bin/go
 
 #ONLY_FOR_PLATFORM?=	*-*-i386 *-*-x86_64 *-*-earmv[67]hf *-*-aarch64
 
