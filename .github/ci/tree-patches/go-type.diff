 # Default:	${GAMES_USER}
 
+#GO_TYPE?=	src
+# Used by Go packages to decide whether the Go toolchain is built from
+# source (lang/go${GO_VERSION_DEFAULT}) or installed from the upstream
+# binary release (lang/go-bin).  Packages that pin a release with
+# GO_VERSION_REQD always build it from source.
