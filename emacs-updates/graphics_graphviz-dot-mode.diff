diff -ruN -x CVS -x work -x '*.orig' /usr/pkgsrc/graphics/graphviz-dot-mode/files/graphviz-dot-e20.el graphics/graphviz-dot-mode/files/graphviz-dot-e20.el
--- /usr/pkgsrc/graphics/graphviz-dot-mode/files/graphviz-dot-e20.el	1970-01-01 00:00:00.000000000 +0000
+++ graphics/graphviz-dot-mode/files/graphviz-dot-e20.el	2026-09-21 18:47:10.643812449 +0000
@@ -0,0 +1,40 @@
+;;; graphviz-dot-e20.el --- graphviz-dot-mode 0.5 on Emacs 20
+
+;; graphviz-dot-mode 0.5.0 asks for Emacs 25.  What it needs comes from
+;; devel/cl-lib-el and e20-compat.el (devel/emacs-compat); the compile.el
+;; table below is the one piece specific to this mode.  Load it before
+;; byte-compiling the mode too, so the macros expand.
+
+(require 'cl-lib)
+(require 'e20-compat)
+
+;; 22: compile.el's table of named error regexps; Emacs 20 has only the
+;; flat list, so the name the mode adds is replaced by its entry.
+(or (boundp 'compilation-error-regexp-alist-alist)
+    (progn
+      (defvar compilation-error-regexp-alist-alist nil)
+      (eval-after-load "graphviz-dot-mode"
+	'(let ((e (assq 'dot compilation-error-regexp-alist-alist)))
+	   (when e
+	     (require 'compile)
+	     (setq compilation-error-regexp-alist
+		   (cons (cdr e) (delq 'dot compilation-error-regexp-alist))))))))
+
+;; Emacs 20 gives a single-character comment starter style a whatever its
+;; flags say, so a "#" line would only end at a style-a newline, while
+;; the mode's newline ends style b, for //.  Swap the two styles on Emacs
+;; 20: // and # become style a, /* */ style b, and the newline ends a.
+(defvar graphviz-dot-e20-propertize-function nil)
+(defun graphviz-dot-e20-setup ()
+  (when (< emacs-major-version 21)
+    (modify-syntax-entry ?/  ". 124" (syntax-table))
+    (modify-syntax-entry ?*  ". 23b" (syntax-table))
+    (modify-syntax-entry ?\n ">"     (syntax-table))
+    (or graphviz-dot-e20-propertize-function
+	(setq graphviz-dot-e20-propertize-function
+	      (syntax-propertize-rules ("^#" (0 "<")))))
+    (set (make-local-variable 'syntax-propertize-function)
+	 graphviz-dot-e20-propertize-function)))
+(add-hook 'graphviz-dot-mode-hook 'graphviz-dot-e20-setup)
+
+(provide 'graphviz-dot-e20)
