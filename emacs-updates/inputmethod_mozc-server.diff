-.include "../../mk/bsd.prefs.mk"
+# Lay the GYP scaffolding from 3.33.6089 over the tree.  Where 3.34 already has
+# a file of the same name, 3.34 wins -- what is wanted here is how it builds,
+# not what it builds.  Several build_tools files are shared and were fixed in
+# 3.34, so the other direction would let the older copies take over.
+#
+# The list goes through a file rather than a pipe because the exit status of
+# ${FIND} is thrown away on the left of |.  An empty tree would walk straight
+# through the loop, no scaffolding would be laid down, and the build would get
+# as far as do-configure before failing as if build_mozc.py had never existed.
+post-extract:
+	${RUN} cd ${MOZC_GYP_SRC};						\
+	${FIND} . -type f -print > ${WRKDIR}/.mozc-gyp-files;			\
+	while read f; do							\
+		case "$$f" in							\
+		*.gyp|*.gypi|./gyp/*|./protobuf/*|./build_mozc.py|./build_tools/*) \
+			;;							\
+		*)	continue ;;						\
+		esac;								\
+		if ${TEST} -e "${WRKSRC}/$$f"; then continue; fi;		\
+		${MKDIR} "${WRKSRC}/$${f%/*}";					\
+		${CP} -p "$$f" "${WRKSRC}/$$f";					\
+	done < ${WRKDIR}/.mozc-gyp-files;					\
+	${RM} -f ${WRKDIR}/.mozc-gyp-files
 
 OPSYSVARS+=	OSDEST
+.if ${MOZC_BUILDER} == "bazel"
 OSDEST.Linux=	linux-opt
 OSDEST.NetBSD=	netbsd-opt
+.else
+OSDEST.Linux=	linux
+OSDEST.NetBSD=	bsd
+
+MOZC_BUILD_MODE?=	Release
+
+do-configure:
+	cd ${WRKSRC} && ${SETENV} ${MAKE_ENV} \
+		${PYTHONBIN} build_mozc.py gyp \
+			--gypdir=${LOCALBASE}/bin \
+			${MOZC_GYP_ARGS}
+.endif
 
 CHECK_PIE_SUPPORTED=	no
+# The data files are read out of dist/ rather than copied in.  They live under
+# DIST_SUBDIR, so the link has to name it; pointing at ${DISTDIR} alone only
+# resolves on a machine that happens to still have an older unprefixed copy.
 pre-configure:
 	${MKDIR} ${WRKSRC}/dist
 .for d in ${MOZC_DISTS}
-	${LN} -s ${DISTDIR}/${d} ${WRKSRC}/dist/${d}
+	${LN} -s ${DISTDIR}/${DIST_SUBDIR}/${d} ${WRKSRC}/dist/${d}
 .endfor
 	${RM} -r ${WRKDIR}/.cwrapper
 
