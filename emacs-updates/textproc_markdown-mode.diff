+# 2.8 requires color.el, which arrived in Emacs 24 and XEmacs does not have
+EMACS_VERSIONS_ACCEPTED=	emacs31 emacs31nox emacs30 emacs30nox emacs29 emacs29nox
+
 .include "../../editors/emacs/modules.mk"
 
