--- /usr/pkgsrc/devel/semi/patches/patch-SEMI-MK	1970-01-01 00:00:00.000000000 +0000
+++ devel/semi/patches/patch-SEMI-MK	2026-09-22 19:36:39.861070225 +0000
@@ -0,0 +1,34 @@
+$NetBSD$
+
+Build with XEmacs 21.5.
+
+XEmacs renamed batch-update-directory to batch-update-directory-autoloads
+and changed what it reads: the feature name and the directory both come
+from command-line-args-left, feature name first, rather than the name
+coming from autoload-package-name.  Called the old way it takes the
+directory for the feature name and then has no directory left, so the
+build stops with "Wrong type argument: stringp, nil" before it compiles
+anything.  FLIM-MK in devel/flim already branches this way; this is the
+same branch, with semi in place of flim.
+
+--- SEMI-MK.orig
++++ SEMI-MK
+@@ -70,9 +70,15 @@
+ (defun compile-semi-package ()
+   (config-semi-package)
+ 
+-  (setq autoload-package-name "semi")
+-  (add-to-list 'command-line-args-left ".")
+-  (batch-update-directory)
++  (if (fboundp 'batch-update-directory-autoloads)
++      ;; XEmacs 21.5.19 and newer.
++      (progn
++	(add-to-list 'command-line-args-left ".")
++	(add-to-list 'command-line-args-left "semi")
++	(batch-update-directory-autoloads))
++    (setq autoload-package-name "semi")
++    (add-to-list 'command-line-args-left ".")
++    (batch-update-directory))
+ 
+   (add-to-list 'command-line-args-left ".")
+   (Custom-make-dependencies)
