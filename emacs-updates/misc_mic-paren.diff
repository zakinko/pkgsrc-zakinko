@@ -0,0 +1,17 @@
+$NetBSD$
+
+3.15 dropped (require 'cl) but still calls cl-minusp and cl-oddp,
+which are only defined once cl-lib is loaded; paren-activate then fails
+with a void cl-oddp in an Emacs where nothing else loaded it.  From Gentoo.
+
+--- mic-paren.el.orig
++++ mic-paren.el
+@@ -332,6 +332,8 @@
+ (defvar mic-paren-version "3.15"
+   "Version of mic-paren.")
+ 
++(require 'cl-lib)
++
+ ;;; ======================================================================
+ ;; Compatibility stuff
+ ;; BLOB to make custom stuff work even without customize
