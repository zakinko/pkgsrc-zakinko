diff -ruN -x CVS -x work /usr/pkgsrc/misc/mic-paren/Makefile misc/mic-paren/Makefile
--- /usr/pkgsrc/misc/mic-paren/Makefile	2022-05-14 22:25:40.000000000 +0000
+++ misc/mic-paren/Makefile	2026-09-21 21:43:06.688403032 +0000
@@ -1,21 +1,29 @@
 # $NetBSD: Makefile,v 1.2 2022/05/14 22:25:40 dholland Exp $
 
-DISTNAME=	mic-paren-3.13
-PKGREVISION=	1
+DISTNAME=	mic-paren-3.15
 CATEGORIES=	misc
-MASTER_SITES=	${MASTER_SITE_GITHUB:=emacsattic/}
-GITHUB_TAG=	d0410c7d805c9aaf51a1bcefaaef092bed5824c4
+# 3.15 is the last release from gnuvola.org, which now sits behind a
+# cookie check that fetch cannot pass; Gentoo keeps a copy.
+MASTER_SITES=	https://dev.gentoo.org/~ulm/distfiles/
+EXTRACT_SUFX=	.el.xz
 
 MAINTAINER=	pho@cielonegro.org
-HOMEPAGE=	https://melpa.org/\#/mic-paren
+HOMEPAGE=	https://www.gnuvola.org/software/j/mic-paren/
 COMMENT=	Advanced highlighting of parenthesis
 LICENSE=	gnu-gpl-v3
 
+WRKSRC=			${WRKDIR}
+USE_TOOLS+=		xz
+
+# a single xz-compressed file; pkgsrc's extract only knows tar.xz
+do-extract:
+	xz -dc ${DISTDIR}/${DISTFILES} > ${WRKSRC}/mic-paren.el
+
 EMACS_MODULES=		base
 EMACS_BUILDLINK=	yes
 
 do-build:
-	cd ${WRKSRC} && ${EMACS_BIN} -batch -f batch-byte-compile *.el
+	cd ${WRKSRC} && ${EMACS_BIN} -batch -f batch-byte-compile mic-paren.el
 
 INSTALLATION_DIRS+=	${EMACS_LISPPREFIX}
 do-install:
