-INSTALLATION_DIRS+=	share/doc/elscreen
+# This is the maintained fork of ElScreen 1.4.6.  It no longer needs
+# APEL, and needs Emacs 24 or later.
+EMACS_VERSIONS_ACCEPTED=	emacs29 emacs29nox emacs30 emacs30nox emacs31 emacs31nox
+
+INSTALLATION_DIRS=	${EMACS_LISPPREFIX}/elscreen share/doc/elscreen
+
+do-build:
+	cd ${WRKSRC} && ${EMACS_BIN} --no-init-file --no-site-file -batch \
+		-L . -f batch-byte-compile elscreen.el
 
 do-install:
-	${INSTALL_DATA} ${WRKDIR}/*/*.el ${DESTDIR}${EMACS_LISPPREFIX}/elscreen
-	${INSTALL_DATA} ${WRKSRC}/README ${DESTDIR}${PREFIX}/share/doc/elscreen
+	cd ${WRKSRC} && ${INSTALL_DATA} *.el elscreen.elc \
+		${DESTDIR}${EMACS_LISPPREFIX}/elscreen
+	cd ${WRKSRC} && ${INSTALL_DATA} Readme.md GF-README GF-QuickStart \
+		${DESTDIR}${PREFIX}/share/doc/elscreen
 
 .include "../../editors/emacs/modules.mk"
-
-.include "../../devel/apel/buildlink3.mk"
 .include "../../mk/bsd.pkg.mk"
