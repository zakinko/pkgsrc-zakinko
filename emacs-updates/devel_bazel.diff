diff -urN -x CVS -x '*.orig' -x '*.rej' old/bazel/patches/patch-MODULE.bazel new/bazel/patches/patch-MODULE.bazel
--- devel/bazel/patches/patch-MODULE.bazel	1970-01-01 00:00:00.000000000 +0000
+++ devel/bazel/patches/patch-MODULE.bazel	2026-09-24 05:22:28.464293255 +0000
@@ -0,0 +1,70 @@
+$NetBSD$
+
+Teach the module graph about NetBSD.
+
+None of platforms, rules_java or rules_go knows this system.  platforms
+returns no @platforms//os value for it, so every select() on
+//src/conditions:netbsd would fall through to the default; rules_java has
+no jni_md.h to offer; and rules_go goes looking for a Go SDK that is not
+published for NetBSD.  Patch the three where they are fetched, and use the
+Go that is already installed.
+
+--- MODULE.bazel.orig
++++ MODULE.bazel
+@@ -59,7 +59,7 @@
+ bazel_dep(name = "rules_apple", version = "4.3.1", repo_name = None)
+ bazel_dep(name = "google_benchmark", version = "1.9.4", repo_name = None)
+ bazel_dep(name = "onetbb", version = "2022.2.0", repo_name = None)
+-bazel_dep(name = "rules_go", version = "0.59.0", repo_name = None)  # Required for loads of CcInfo
++bazel_dep(name = "rules_go", version = "0.59.0")  # Required for loads of CcInfo
+ 
+ # bazel_dep overrides
+ single_version_override(
+@@ -84,7 +84,10 @@
+ single_version_override(
+     module_name = "zstd-jni",
+     patch_strip = 1,
+-    patches = ["//third_party:zstd-jni.patch"],
++    patches = [
++        "//third_party:zstd-jni.patch",
++        "//toolchain_local:zstd_jni-netbsd.patch",
++    ],
+ )
+ 
+ single_version_override(
+@@ -137,6 +140,35 @@
+     path = "./third_party/remoteapis",
+ )
+ 
++# NetBSD is not among the platforms these modules know about.
++#   platforms   host detection returns no @platforms//os value, so every
++#               select() on //src/conditions:netbsd would miss.
++#   rules_java  has no jni_md_header for NetBSD.
++#   rules_go    downloads a Go SDK that is not published for NetBSD; use the
++#               one installed on this machine instead.
++single_version_override(
++    module_name = "platforms",
++    patch_strip = 1,
++    patches = ["//toolchain_local:platforms-pr142-pr143.patch"],
++)
++
++single_version_override(
++    module_name = "rules_java",
++    patch_strip = 1,
++    patches = ["//toolchain_local:rules_java-pr381.patch"],
++)
++
++single_version_override(
++    module_name = "rules_go",
++    patch_strip = 1,
++    patches = ["//toolchain_local:rules_go-pr4711.patch"],
++    version = "0.59.0",
++)
++
++go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
++go_sdk.host(name = "go_default_sdk")
++
++
+ # =========================================
+ # Java dependencies
+ # =========================================
