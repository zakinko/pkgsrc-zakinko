diff -ruN -x CVS -x work -x '*.orig' -x '*.rej' /usr/pkgsrc/print/auctex/Makefile print/auctex/Makefile
--- /usr/pkgsrc/print/auctex/Makefile	2026-09-18 05:48:41.763469011 +0000
+++ print/auctex/Makefile	2026-09-24 09:33:06.970065915 +0000
@@ -1,56 +1,42 @@
 # $NetBSD: Makefile,v 1.91 2026/09/02 19:04:06 wiz Exp $
 
-DISTNAME=		auctex-13.3
+DISTNAME=		auctex-14.2.0
 PKGNAME=		${EMACS_PKGNAME_PREFIX}${DISTNAME}
-PKGREVISION=		14
 CATEGORIES=		print
-MASTER_SITES=		${MASTER_SITE_GNU:=auctex/}
+MASTER_SITES=		https://elpa.gnu.org/packages/
+EXTRACT_SUFX=		.tar
 
 MAINTAINER=		pkgsrc-users@NetBSD.org
 HOMEPAGE=		https://www.gnu.org/software/auctex/
 COMMENT=		Enhanced LaTeX mode for Emacs
 LICENSE=		gnu-gpl-v3
 
-TOOL_DEPENDS+=		tex-texlive-scripts-extra-[0-9]*:../../print/tex-texlive-scripts-extra
+# AUCTeX 14 is released through GNU ELPA only; the tarball is the ELPA
+# package, which expects to run from its own directory (tex-site.el
+# finds the styles and data beside itself), so it is installed whole
+# under ${EMACS_LISPPREFIX}/auctex.
 DEPENDS+=		texlive-collection-latex>=2014:../../meta-pkgs/texlive-collection-latex
 
 EMACS_VERSIONS_ACCEPTED=	emacs31 emacs31nox emacs30 emacs30nox emacs29 emacs29nox
 
-.include "../../mk/bsd.prefs.mk"
-
-USE_TOOLS+=		gmake makeinfo perl
-GNU_CONFIGURE=		YES
-
-CONFIGURE_ENV=		GS=${PREFIX}/bin/gs
-CONFIGURE_ARGS+=	${CONFIGURE_ARGS.${EMACS_FLAVOR}}
-CONFIGURE_ARGS+=	--enable-preview
-CONFIGURE_ARGS+=	--localstatedir=${VARBASE}
-
-CONFIGURE_ARGS.emacs=	--with-lispdir=${EMACS_LISPPREFIX}
-
-# We are not building an XEmacs package!
-CONFIGURE_ARGS.xemacs=	--without-packagedir
-CONFIGURE_ARGS.xemacs+=	--with-lispdir=${EMACS_LISPPREFIX}
-
-MAKEFLAGS+=		EMACS=${EMACS_BIN:Q}
-
-BUILD_DEFS+=		VARBASE
-
-EMACS_MODULES=		base
-
-MESSAGE_SUBST+=		LISPDIR=${EMACS_LISPPREFIX:Q}
+USE_TOOLS+=		pax
 INFO_FILES=		YES
-
 TEXMFDIR=		share/texmf-local
-
-INSTALLATION_DIRS=	share/doc/auctex
-INSTALLATION_DIRS+=	${EMACS_INFOPREFIX}
-INSTALLATION_DIRS+=	${EMACS_LISPPREFIX}
-INSTALLATION_DIRS+=	${EMACS_LISPPREFIX}/auctex
+INSTALLATION_DIRS=	${EMACS_INFOPREFIX} ${EMACS_LISPPREFIX}/auctex
 INSTALLATION_DIRS+=	${TEXMFDIR}/tex/latex/preview
 
-MAKE_DIRS_PERMS+=	${VARBASE}/auctex ${REAL_ROOT_USER} ${REAL_ROOT_GROUP} 1777
+do-build:
+	cd ${WRKSRC} && ${EMACS_BIN} --no-init-file --no-site-file -batch \
+		-L . -f batch-byte-compile *.el style/*.el
+
+do-install:
+	cd ${WRKSRC} && ${PAX} -rw -pp -s ',^\./doc.*,,' -s ',^\./latex.*,,' \
+		-s ',^\./[^/]*\.info$$,,' -s ',^\./dir$$,,' \
+		-s ',^\./GNUmakefile,,' . ${DESTDIR}${EMACS_LISPPREFIX}/auctex
+	cd ${WRKSRC} && ${INSTALL_DATA} auctex.info preview-latex.info \
+		${DESTDIR}${EMACS_INFOPREFIX}
+	cd ${WRKSRC}/latex && ${INSTALL_DATA} preview.sty *.def prauctex.cfg \
+		${DESTDIR}${PREFIX}/${TEXMFDIR}/tex/latex/preview
 
-.include "../../print/ghostscript/buildlink3.mk"
 .include "../../editors/emacs/modules.mk"
 .include "../../mk/bsd.pkg.mk"
