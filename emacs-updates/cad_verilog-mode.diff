diff -ruN -x CVS -x work -x '*.orig' /usr/pkgsrc/cad/verilog-mode/files/verilog-e20.el cad/verilog-mode/files/verilog-e20.el
--- /usr/pkgsrc/cad/verilog-mode/files/verilog-e20.el	1970-01-01 00:00:00.000000000 +0000
+++ cad/verilog-mode/files/verilog-e20.el	2026-09-22 16:24:29.341605042 +0000
@@ -0,0 +1,12 @@
+;;; verilog-e20.el --- what Emacs 20 lacks for verilog-mode
+
+;; verilog-mode.el calls dolist and remove at compile time, and
+;; make-obsolete-variable with the WHEN argument at load time.  pkgsrc's
+;; elisp-compat has all three; pull it in when this is an Emacs that needs it,
+;; and do nothing anywhere else.
+
+(when (and (not (featurep 'xemacs)) (< emacs-major-version 21))
+  (require 'cl)
+  (require 'elisp-compat))
+
+(provide 'verilog-e20)
diff -ruN -x CVS -x work -x '*.orig' /usr/pkgsrc/cad/verilog-mode/patches/patch-verilog-mode.el cad/verilog-mode/patches/patch-verilog-mode.el
--- /usr/pkgsrc/cad/verilog-mode/patches/patch-verilog-mode.el	1970-01-01 00:00:00.000000000 +0000
+++ cad/verilog-mode/patches/patch-verilog-mode.el	2026-09-22 16:25:05.848492090 +0000
@@ -0,0 +1,19 @@
+$NetBSD$
+
+verilog-mode calls make-obsolete-variable with the WHEN argument, which
+Emacs 20 does not take, so the compiled file fails to load there.
+devel/elisp-compat has the three-argument form (and dolist and remove,
+which the byte-compiler needs); files/verilog-e20.el pulls it in when this
+is an Emacs 20, and is a no-op anywhere else.  The require is soft, so the
+file still loads if that file is not installed.
+
+--- verilog-mode.el.orig
++++ verilog-mode.el
+@@ -1,5 +1,7 @@
+ ;;; verilog-mode.el --- major mode for editing verilog source in Emacs  -*- lexical-binding: t; -*-
+ 
++(require (quote verilog-e20) nil t)   ; Emacs 20: pkgsrc's elisp-compat
