+# $NetBSD$
+
+DISTNAME=	reformatter-0.7
+PKGNAME=	${EMACS_PKGNAME_PREFIX}${DISTNAME:S/reformatter/reformatter-el/}
+CATEGORIES=	devel
+MASTER_SITES=	${MASTER_SITE_GITHUB:=purcell/}
+GITHUB_PROJECT=	emacs-reformatter
+GITHUB_TAG=	${PKGVERSION_NOREV}
+
+MAINTAINER=	pkgsrc-users@NetBSD.org
+HOMEPAGE=	https://github.com/purcell/emacs-reformatter
+COMMENT=	Define commands which run reformatters on the current Emacs buffer
+LICENSE=	gnu-gpl-v3
+
+EMACS_VERSIONS_ACCEPTED=	emacs29 emacs29nox emacs30 emacs30nox emacs31 emacs31nox
+
+INSTALLATION_DIRS=	${EMACS_LISPPREFIX}/reformatter
+
+do-build:
+	${EMACS_BIN} --no-init-file --no-site-file -batch \
+		-f batch-byte-compile ${WRKSRC}/reformatter.el
+
+do-install:
+	${INSTALL_DATA} ${WRKSRC}/reformatter.el ${WRKSRC}/reformatter.elc \
+		${DESTDIR}${EMACS_LISPPREFIX}/reformatter
+
+.include "../../editors/emacs/modules.mk"
+.include "../../mk/bsd.pkg.mk"
