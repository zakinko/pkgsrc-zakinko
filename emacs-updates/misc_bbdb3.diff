diff -ruN -x CVS -x work /usr/pkgsrc/misc/bbdb3/Makefile misc/bbdb3/Makefile
--- /usr/pkgsrc/misc/bbdb3/Makefile	2026-08-27 07:51:11.767805400 +0000
+++ misc/bbdb3/Makefile	2026-09-21 21:40:36.798791922 +0000
@@ -1,10 +1,10 @@
 # $NetBSD: Makefile,v 1.7 2026/08/26 14:37:06 wiz Exp $
 
-DISTNAME=		bbdb-3.2.2a
-PKGREVISION=		3
+DISTNAME=		bbdb-3.2.2.4
 PKGNAME=		${EMACS_PKGNAME_PREFIX}${DISTNAME}
 CATEGORIES=		misc mail news
-MASTER_SITES=		http://git.savannah.nongnu.org/cgit/bbdb.git/snapshot/
+MASTER_SITES=		https://elpa.gnu.org/packages/
+EXTRACT_SUFX=		.tar
 
 MAINTAINER=		pkgsrc-users@NetBSD.org
 HOMEPAGE=		https://elpa.gnu.org/packages/bbdb.html
@@ -19,27 +19,44 @@
 
 CONFLICTS+=		xemacs-packages-[0-9]*
 
-USE_PKGLOCALEDIR=	yes
-GNU_CONFIGURE=		yes
-USE_TOOLS+=		autoconf automake autoreconf
+NO_CONFIGURE=		yes
 LISPDIR=		${EMACS_LISPPREFIX}/bbdb
-INSTALLATION_DIRS=	${EMACS_INFOPREFIX}
+INSTALLATION_DIRS=	${LISPDIR:C|^${PREFIX}/||} share/bbdb
 
-# The info document is an example info document,
-# no real documentary content yet. If this will
-# change, remove this from doc/Makefile.am:
-# doc_DATA = bbdb.pdf
-#
-# bbdb.info bbdb.pdf: $(bbdb_TEXINFOS)
-CONFIGURE_ARGS+=	--enable-docs=no
-
-pre-configure:
-	cd ${WRKSRC} && autoreconf --verbose --install
+# The GNU ELPA tarball is the release; git.savannah.nongnu.org, where
+# the earlier snapshot came from, answers 400 and 502 too often to
+# fetch from.  ELPA ships bbdb-site.el with the configure placeholders
+# still in it, so fill them in here.
+SUBST_CLASSES+=		site
+SUBST_STAGE.site=	post-extract
+SUBST_FILES.site=	bbdb-site.el
+SUBST_SED.site=		-e 's|@PACKAGE_VERSION@|${PKGVERSION_NOREV}|'
+SUBST_SED.site+=	-e 's|@pkgdatadir@|${PREFIX}/share/bbdb|'
+
+# bbdb-vm, bbdb-mu4e, bbdb-notmuch and bbdb-wl need their MUA to
+# compile; bbdb-pkg.el is package.el metadata.  Same set upstream's
+# make leaves as source.  bbdb-loaddefs.el gets the load-path prelude
+# upstream's make puts in front of the autoloads.
+COMPILE_EL=	bbdb bbdb-anniv bbdb-com bbdb-gnus bbdb-ispell bbdb-message \
+		bbdb-mhe bbdb-migrate bbdb-mua bbdb-pgp bbdb-rmail bbdb-site \
+		bbdb-snarf bbdb-tex
+
+# The info file is a placeholder ("First Chapter"), as it was in the git
+# snapshot, so it is not installed.
+do-build:
+	cd ${WRKSRC} && ${EMACS_BIN} -batch -q --no-site-file -L . \
+		-f batch-byte-compile ${COMPILE_EL:=.el}
+	cd ${WRKSRC} && ${EMACS_BIN} -batch -q --no-site-file -L . \
+		-f loaddefs-generate-batch bbdb-loaddefs.el .
+	${ECHO} "(if (and load-file-name (file-name-directory load-file-name))" > ${WRKSRC}/bbdb-loaddefs.el.tmp
+	${ECHO} "    (add-to-list 'load-path (file-name-directory load-file-name)))" >> ${WRKSRC}/bbdb-loaddefs.el.tmp
+	${ECHO} "" >> ${WRKSRC}/bbdb-loaddefs.el.tmp
+	${CAT} ${WRKSRC}/bbdb-loaddefs.el >> ${WRKSRC}/bbdb-loaddefs.el.tmp
+	${MV} ${WRKSRC}/bbdb-loaddefs.el.tmp ${WRKSRC}/bbdb-loaddefs.el
 
 do-install:
-	${MKDIR} ${DESTDIR}${LISPDIR}
-	${INSTALL_DATA} ${WRKSRC}/lisp/*.el ${DESTDIR}${LISPDIR}
-	${INSTALL_DATA} ${WRKSRC}/lisp/*.elc ${DESTDIR}${LISPDIR}
+	${INSTALL_DATA} ${WRKSRC}/*.el ${WRKSRC}/*.elc ${DESTDIR}${LISPDIR}
+	${INSTALL_DATA} ${WRKSRC}/tex/bbdb.sty ${DESTDIR}${PREFIX}/share/bbdb
 
 .include "../../editors/emacs/modules.mk"
 .include "../../mk/bsd.pkg.mk"
