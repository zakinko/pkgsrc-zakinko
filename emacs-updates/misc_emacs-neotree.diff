diff -ruN -x CVS -x work -x '*.orig' /usr/pkgsrc/misc/emacs-neotree/Makefile misc/emacs-neotree/Makefile
--- /usr/pkgsrc/misc/emacs-neotree/Makefile	2022-05-14 22:25:40.000000000 +0000
+++ misc/emacs-neotree/Makefile	2026-09-22 18:42:14.696109036 +0000
@@ -1,11 +1,15 @@
 # $NetBSD: Makefile,v 1.2 2022/05/14 22:25:40 dholland Exp $
 
-DISTNAME=	emacs-neotree-0.5.2.98fe213
+DISTNAME=	emacs-neotree-0.6.0
 PKGNAME=	${EMACS_PKGNAME_PREFIX}${DISTNAME}
-PKGREVISION=	1
 CATEGORIES=	misc
 MASTER_SITES=	${MASTER_SITE_GITHUB:=jaypei/}
-GITHUB_TAG=	98fe21334affaffe2334bf7c987edaf1980d2d0b
+GITHUB_TAG=	${PKGVERSION_NOREV}
+
+# GitHub の既定は ${WRKDIR}/${PKGNAME} を指すが、PKGNAME には
+# EMACS_PKGNAME_PREFIX が付く。XEmacs では xemacs-... を探して
+# 展開先と食い違うので、DISTNAME で指す。
+WRKSRC=		${WRKDIR}/emacs-neotree-0.6.0
 
 MAINTAINER=	pkgsrc-users@NetBSD.org
 HOMEPAGE=	https://github.com/jaypei/emacs-neotree/
@@ -25,5 +29,8 @@
 	${INSTALL_DATA} ${WRKSRC}/icons/*.xpm \
 		${DESTDIR}${EMACS_LISPPREFIX}/neotree/icons
 
+# 0.6.0 uses pcase backquote patterns, which the XEmacs reader takes for the old backquote and rejects
+EMACS_VERSIONS_ACCEPTED=	emacs31 emacs31nox emacs30 emacs30nox emacs29 emacs29nox
+
 .include "../../editors/emacs/modules.mk"
 .include "../../mk/bsd.pkg.mk"
