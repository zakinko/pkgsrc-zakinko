 # $NetBSD: Makefile,v 1.5 2026/09/12 14:31:49 wiz Exp $
 
-DISTNAME=	ecb-2.50
+DISTNAME=	ecb-2.52
 PKGNAME=	${EMACS_PKGNAME_PREFIX}${DISTNAME}
-PKGREVISION=	1
 CATEGORIES=	devel
-
 MASTER_SITES=	${MASTER_SITE_GITHUB:=ecb-home/}
-GITHUB_TAG=	1330a44cf3c171781083b0b926ab7622f64e6e81
+GITHUB_TAG=	v${PKGVERSION_NOREV}
 
-MAINTAINER=	pho@cielonegro.org
+MAINTAINER=	pkgsrc-users@NetBSD.org
 HOMEPAGE=	https://github.com/ecb-home/ecb
 COMMENT=	Emacs Code Browser
 LICENSE=	gnu-gpl-v2
 
-USE_TOOLS=	find gmake makeinfo tar
+USE_TOOLS+=	gmake makeinfo bash pax
 INFO_FILES=	yes
+# CEDET (semantic, eieio, speedbar) has been part of Emacs since 23.2,
+# and ECB 2.5x is the fork that follows the bundled one.
+EMACS_VERSIONS_ACCEPTED=	emacs29 emacs29nox emacs30 emacs30nox emacs31 emacs31nox
 
-EMACS_VERSIONS_ACCEPTED=	xemacs215 xemacs215nox xemacs214 xemacs214nox
+MAKE_FLAGS+=	EMACS=${EMACS_BIN:Q} CEDET= SHELL=${TOOLS_PATH.bash}
+BUILD_TARGET=	ecb online-help
 
-MAKE_FLAGS+=		EMACS=${EMACS_BIN}
-MAKE_FLAGS+=		SHELL=${SH:Q}
-EMACS_MODULES=		base
-EMACS_BUILDLINK=	yes
-
-INSTALLATION_DIRS+=	\
-	${PKGINFODIR} \
-	${EMACS_LISPPREFIX}/${PKGBASE}
+INSTALLATION_DIRS=	${EMACS_LISPPREFIX}/ecb ${EMACS_INFOPREFIX}
 
 do-install:
-	${INSTALL_DATA} ${WRKSRC}/*.el  ${DESTDIR}${EMACS_LISPPREFIX}/${PKGBASE}
-	${INSTALL_DATA} ${WRKSRC}/*.elc ${DESTDIR}${EMACS_LISPPREFIX}/${PKGBASE}
-	${INSTALL_DATA} ${WRKSRC}/info-help/ecb.info* ${DESTDIR}${PREFIX}/${PKGINFODIR}
-	${TAR} -cf - -C ${WRKSRC} ecb-images | \
-		${TAR} -xf - -C ${DESTDIR}${EMACS_LISPPREFIX}/${PKGBASE}
+	cd ${WRKSRC} && ${INSTALL_DATA} *.el *.elc \
+		${DESTDIR}${EMACS_LISPPREFIX}/ecb
+	cd ${WRKSRC} && ${PAX} -rw -pp ecb-images ${DESTDIR}${EMACS_LISPPREFIX}/ecb
+	${INSTALL_DATA} ${WRKSRC}/info-help/ecb.info* ${DESTDIR}${EMACS_INFOPREFIX}
 
 .include "../../editors/emacs/modules.mk"
 .include "../../mk/bsd.pkg.mk"
