@@ -0,0 +1,16 @@
+$NetBSD$
+
+Emacs 30 refuses a defcustom whose :type is a bare `list' ("`list' without
+arguments" at byte-compile).  Upstream spells it (list string) now.
+
+--- haskell-commands.el.orig	2026-09-04 00:00:00.000000000 +0000
++++ haskell-commands.el
+@@ -46,7 +46,7 @@
+ (defcustom haskell-mode-stylish-haskell-args nil
+   "Arguments to pass to program specified by haskell-mode-stylish-haskell-path."
+   :group 'haskell
+-  :type 'list)
++  :type '(list string))
+ 
+ (defcustom haskell-interactive-set-+c
+   t
