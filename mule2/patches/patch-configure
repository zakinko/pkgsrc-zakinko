+
+# ここまでで選んだ cpp が、\ で継いだ行を一行に繋ぐかどうかを確かめる。
+# Makefile.in は ALL_CFLAGS などの代入を \ で継いでいて、繋がない cpp を
+# 通すと続きの行がそのまま残る。configure はこの後 sed で行頭の空白を
+# TAB に直すので、GNU make はそれを recipe と読み、target より前に recipe
+# があると言って止まる。BSD make は通ってしまうので、気付くのが遅れる。
+#
+# 上の検査は cc -E, cc -E -traditional-cpp, /lib/cpp の順に試すが、最後の
+# /lib/cpp だけは繋ぐかどうかを見ずに採る。Linux では /lib/cpp が素の cpp
+# なので、そこに落ちると繋がないものを掴む。
+echo 'Should \' > conftest.cppjoin.c
+echo 'be one line.' >> conftest.cppjoin.c
+if $CPP conftest.cppjoin.c 2>/dev/null | grep "Should  *be one line" > /dev/null; then
+  :
+else
+  echo "$progname: $CPP does not join continued lines, using -traditional-cpp"
+  CPP="${CC-cc} -E -traditional-cpp"
+fi
+rm -f conftest.cppjoin.c
