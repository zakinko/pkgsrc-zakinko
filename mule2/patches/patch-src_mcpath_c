+++ src/mcpath.c
@@ -25,6 +25,7 @@
 
 #define MCPATH_SOURCE
 #include <stdio.h>
+#include <stdlib.h>
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <sys/param.h>
@@ -486,7 +487,7 @@
 }
 #endif
 
