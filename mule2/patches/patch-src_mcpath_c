+++ src/mcpath.c
@@ -25,6 +25,7 @@
 
 #define MCPATH_SOURCE
 #include <stdio.h>
+#include <stdlib.h>
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <sys/param.h>
@@ -425,7 +426,7 @@
 {
   unsigned char buffer[MC_MAXPATHLEN];
   argv[0] = path = decode_path (path, buffer);
-  execvp (path, argv);
+  execvp (path, (char * const *) argv);
 }
