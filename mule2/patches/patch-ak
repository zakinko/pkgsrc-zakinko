$NetBSD$

Give last_event_timestamp a definition when there is no window system.
xterm.c owns it otherwise, but the event loop records into it either
way, so a terminal-only build had nothing to link against.

--- src/keyboard.c.orig	1995-02-03 01:21:28.000000000 +0000
+++ src/keyboard.c
@@ -53,6 +53,7 @@
 
 #include <config.h>
 #include <stdio.h>
+#include <stdlib.h>
 #undef NULL
 #include "termchar.h"
 #include "termopts.h"
@@ -63,6 +64,7 @@
 #include "termhooks.h"
 #endif
 #include "macros.h"
+#include "process.h"
 #include "frame.h"
 #include "window.h"
 #include "commands.h"
@@ -100,8 +102,6 @@
 /* Include systime.h after xterm.h to avoid double inclusion of time.h. */
 #include "systime.h"
 
-extern int errno;
-
 /* Variables for blockinput.h: */
 
 /* Non-zero if interrupt input is blocked right now.  */
@@ -301,7 +301,14 @@
 
 /* The timestamp of the last input event we received from the X server.
    X Windows wants this for selection ownership.  */
+#ifdef HAVE_X_WINDOWS
+extern unsigned long last_event_timestamp;
+#else
+/* xterm.c defines it when there is a window system.  Without one nobody
+   reads it, but the event loop below still records every event into it,
+   so it has to exist somewhere.  */
 unsigned long last_event_timestamp;
+#endif
 
 Lisp_Object Qself_insert_command;
 Lisp_Object Qforward_char;
@@ -582,8 +589,7 @@
    C can be a character, which is printed prettily ("M-C-x" and all that
    jazz), or a symbol, whose name is printed.  */
 
-echo_char (c)
-     Lisp_Object c;
+static void echo_char(Lisp_Object c)
 {
   extern char *push_key_description ();
 
@@ -629,7 +635,7 @@
 /* Temporarily add a dash to the end of the echo string if it's not
    empty, so that it serves as a mini-prompt for the very next character.  */
 
-echo_dash ()
+static void echo_dash (void)
 {
   if (!immediate_echo && echoptr == echobuf)
     return;
@@ -3570,7 +3576,7 @@
 /* Put a buffer_switch_event in the buffer
    so that read_key_sequence will notice the new current buffer.  */
 
-record_asynch_buffer_change ()
+void record_asynch_buffer_change(void)
 {
   struct input_event event;
   Lisp_Object tem;
@@ -5633,7 +5639,6 @@
   int old_height, old_width;
   int width, height;
   struct gcpro gcpro1, gcpro2;
-  extern init_sys_modes ();
 
   if (!NILP (stuffstring))
     CHECK_STRING (stuffstring, 0);
