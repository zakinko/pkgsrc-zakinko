$NetBSD$

Makefile.in installs with @INSTALL@, which configure fills in with whatever
install it found.  Use pkgsrc's INSTALL_DATA so the modes and ownership are
the ones pkgsrc expects.

--- Makefile.in.orig	Fri Nov  3 04:25:15 2000
+++ Makefile.in
@@ -8,7 +8,7 @@
 DOTEMACS=@DOTEMACS@
 SUBDIRS =lisp texi etc
 
-INSTALL   = @INSTALL@
+INSTALL   = ${INSTALL_DATA}
 RM        = rm -f
 
 .PHONY: $(SUBDIRS) dotemacs
