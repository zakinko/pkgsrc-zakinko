$NetBSD$

Build the right half of the n-acd portability seam.

SO_ATTACH_BPF is defined here only where it means something.  The BSDs install
their packet filter with BIOCSETF while opening the device, so there is no
later moment, and no descriptor, to attach one.

--- src/meson.build.orig
+++ src/meson.build
@@ -18,12 +18,24 @@
   c_args: '-std=c11',
 )
 
+# n-acd reaches the kernel in a handful of places - a packet socket, a poller
+# and a timer - and those are the only parts of it that are not portable. They
+# live in one file per platform rather than in conditionals spread through
+# n-acd.c, so each file reads as one system's idea of networking.
+#
+# SO_ATTACH_BPF is defined below only where it means something: the BSDs attach
+# their filter with BIOCSETF while opening the device, and there is no later
+# moment, nor a descriptor, to attach one.
+n_acd_is_linux = host_machine.system() == 'linux'
+n_acd_os_args = n_acd_is_linux ? ['-DSO_ATTACH_BPF=50'] : []
+
 libn_acd = static_library(
   'n-acd',
   sources: files(
     'n-acd/src/n-acd.c',
     'n-acd/src/n-acd-probe.c',
     'n-acd/src/util/timer.c',
+    n_acd_is_linux ? 'n-acd/src/n-acd-os-linux.c' : 'n-acd/src/n-acd-os-bsd.c',
     enable_ebpf ? 'n-acd/src/n-acd-bpf.c' : 'n-acd/src/n-acd-bpf-fallback.c',
   ),
   include_directories: include_directories(
@@ -35,10 +47,9 @@
   c_args: [
     '-std=c11',
     '-D_GNU_SOURCE',
-    '-DSO_ATTACH_BPF=50',
     '-Wno-pointer-arith',
     '-Wno-vla',
-  ],
+  ] + n_acd_os_args,
 )
 
 libn_dhcp4 = static_library(
