$NetBSD$

Build the right half of the portability seams.

n-acd and n-dhcp4 each have one file per platform for the places they reach the
kernel.  SO_ATTACH_BPF is defined only where it means something: the BSDs
install their packet filter with BIOCSETF while opening the device, so there is
no later moment, and no descriptor, to attach one.

--- src/meson.build.orig
+++ src/meson.build
@@ -24,7 +24,8 @@
     'n-acd/src/n-acd.c',
     'n-acd/src/n-acd-probe.c',
     'n-acd/src/util/timer.c',
-    'n-acd/src/n-acd-bpf.c',
+    nettools_is_linux ? 'n-acd/src/n-acd-os-linux.c' : 'n-acd/src/n-acd-os-bsd.c',
+    nettools_is_linux ? 'n-acd/src/n-acd-bpf.c' : 'n-acd/src/n-acd-bpf-fallback.c',
   ),
   include_directories: include_directories(
     'c-list/src',
@@ -35,10 +36,9 @@
   c_args: [
     '-std=c11',
     '-D_GNU_SOURCE',
-    '-DSO_ATTACH_BPF=50',
     '-Wno-pointer-arith',
     '-Wno-vla',
-  ],
+  ] + nettools_os_args,
 )
 
 libn_dhcp4 = static_library(
@@ -52,7 +52,9 @@
     'n-dhcp4/src/n-dhcp4-outgoing.c',
     'n-dhcp4/src/n-dhcp4-socket.c',
     'n-dhcp4/src/util/packet.c',
-    'n-dhcp4/src/util/socket.c',
+    nettools_is_linux ? 'n-dhcp4/src/n-dhcp4-socket-linux.c' : 'n-dhcp4/src/n-dhcp4-socket-bsd.c',
+    nettools_is_linux ? 'n-dhcp4/src/util/packet-linux.c' : 'n-dhcp4/src/util/packet-bsd.c',
+    nettools_is_linux ? 'n-dhcp4/src/util/socket-linux.c' : 'n-dhcp4/src/util/socket-bsd.c',
   ),
   include_directories: include_directories(
     'c-list/src',
