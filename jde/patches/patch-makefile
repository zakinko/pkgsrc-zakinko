$NetBSD$

Find eieio, elib, semantic and speedbar under EMACS_LISPPREFIX instead
of ../../eieio and friends, which is where they sit in the author's own
tree.

The compile line is left as it is, without a leading "-": with it a
failed byte-compile let the build go on and install the .el files alone.

--- makefile.orig	Mon Dec 30 14:28:06 2002
+++ makefile
@@ -9,10 +9,10 @@
 EMACS = emacs
 
 # Default locations of the packages required to compile the JDE.
-EIEIO = ../../eieio
-ELIB  = ../../elib
-SEMANTIC = ../../semantic
-SPEEDBAR = ../../speedbar
+EIEIO = ${EMACS_LISPPREFIX}/eieio
+ELIB  = ${EMACS_LISPPREFIX}/elib
+SEMANTIC = ${EMACS_LISPPREFIX}/semantic
+SPEEDBAR = ${EMACS_LISPPREFIX}/speedbar
 
 all:
 	test -d $(SEMANTIC) -a -d $(SPEEDBAR) -a -d $(ELIB) -a -d $(EIEIO)
